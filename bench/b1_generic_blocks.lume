# Generic helpers taking blocks, over a big list. Milestones 22-23.

pub def map_all[T, U](xs: [T], f: (T) -> U) -> [U]:
  var out: [U] = []
  for x in xs:
    out.push(f(x))
  out

pub def keep[T](xs: [T], ok: (T) -> Bool) -> [T]:
  var out: [T] = []
  for x in xs:
    if ok(x):
      out.push(x)
  out

pub def fold_all[T, A](xs: [T], start: A, f: (A, T) -> A) -> A:
  var acc = start
  for x in xs:
    acc = f(acc, x)
  acc

def main:
  var xs: [Int] = []
  # three dots: 0 up to but not including 2000000, as Rust's `0..2000000`
  for i in 0...2000000:
    xs.push(i)

  # ten rounds, each with its own factor, so the timed work is long enough
  # to measure (a few milliseconds is mostly timer noise) and no round can be
  # worked out from another
  t0 = Time.now_ms
  var total = 0
  for round in 0...10:
    k = round + 2
    scaled = map_all(xs) { |n| n * k }
    kept = keep(scaled) { |n| n % 3 == 0 }
    total += fold_all(kept, 0) { |a, n| a + n }
  t1 = Time.now_ms

  puts "#{total}"
  puts "#{t1 - t0} ms"
