# Generic helpers taking blocks, over a big list. Milestones 22-23.

pub def map_all[T, U](xs: [T], f: (T) -> U) -> [U]:
  var out: [U] = []
  for x in xs:
    out.push(f(x))
  out

pub def keep[T](xs: [T], ok: (T) -> Bool) -> [T]:
  var out: [T] = []
  for x in xs:
    if ok(x):
      out.push(x)
  out

pub def fold_all[T, A](xs: [T], start: A, f: (A, T) -> A) -> A:
  var acc = start
  for x in xs:
    acc = f(acc, x)
  acc

def main:
  var xs: [Int] = []
  for i in 0..2000000:
    xs.push(i)

  t0 = Time.now_ms
  doubled = map_all(xs) { |n| n * 2 }
  evens = keep(doubled) { |n| n % 3 == 0 }
  total = fold_all(evens, 0) { |a, n| a + n }
  t1 = Time.now_ms

  puts "#{total}"
  puts "#{t1 - t0} ms"
