# The milestone-8 classic: read a file, count a million words, report the top three.

def main:
  text = File.read("bench/words.txt")!
  t0 = Time.now_ms
  var counts: {Str: Int} = {}
  for line in text.lines:
    for w in line.split(" "):
      if not w.empty?:
        counts[w] = counts[w].or(0) + 1
  best = counts.to_list.sort_by { |p| 0 - p.1 }.take(3).to_list
  t1 = Time.now_ms

  for p in best:
    puts "#{p.0} #{p.1}"
  puts "#{counts.len} distinct"
  puts "#{t1 - t0} ms"
