# A generator (`yield`) in a lazy chain: b6's work, written as a function
# instead of a struct with `next`. Milestone 70.

# a linear congruential generator: endless, so only `take` stops it
def rng(seed: Int) -> Iterator[Int]:
  var s = seed
  while true:
    s = (s * 1103515245 + 12345) % 2147483648
    yield s

def main:
  t0 = Time.now_ms
  var total = 0
  for round in 0...10:
    total += rng(round + 1).filter { |x| x % 3 == 0 }.map { |x| x % 1000 }.take(2000000).sum
  t1 = Time.now_ms

  puts "#{total}"
  puts "#{t1 - t0} ms"
