# b07: The result of a generator method is a generator like any other: kept
#   in a local and walked twice, the first walk uses it up.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `e` is a generator, and it is used up here, so it cannot be used after
#   --> corpus/m78/b07_gen_method_twice.lume:22:8
#    |
# 22 |   puts e.sum
#    |        ^
#   help: a generator hands out each item once: to walk the items twice, keep them with `.to_list` first

struct Bag:
  xs: [Int]

  def evens -> Iterator[Int]:
    for x in xs:
      yield x if x % 2 == 0

def main:
  b = Bag(xs: [1, 2, 3, 4])
  e = b.evens
  puts e.sum
  puts e.to_list
