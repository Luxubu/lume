# b12: A generator in an `extend` of a struct of one's own (not a built-in),
#   for an interface whose required method gives `Iterator[Str]`.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `spread` is in an `extend`, and a method there cannot be a generator yet
#   --> corpus/m78/b12_gen_in_extend_struct.lume:19:3
#    |
# 19 |   def spread -> Iterator[Str]:
#    |   ^
#   help: write the generator as a default in the interface, or as a method of the struct or enum itself

interface Spread:
  def spread -> Iterator[Str]

struct Word:
  text: Str

extend Word with Spread:
  def spread -> Iterator[Str]:
    for c in text.chars:
      yield c.upcase

def main:
  puts Word(text: "ab").spread.to_list
