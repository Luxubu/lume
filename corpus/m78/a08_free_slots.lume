# a08_free_slots: a meeting room's free hours, checked against anyone's
# calendar.
# Probes: a generator method whose parameter is an interface value, which
# the collections page lists under "Not yet: ... a generator that takes a
# block or an interface value". The program is what a user would write
# first; the error should name the parameter.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: a generator cannot take `cal` yet: it keeps what it is given, and a block or an interface value cannot be kept that way
#   --> corpus/m78/a08_free_slots.lume:30:18
#    |
# 30 |   def free_slots(cal: Calendar) -> Iterator[Str]:
#    |                  ^
#   help: pass the values the generator needs instead

interface Calendar:
  def busy?(hour: Int) -> Bool

struct Person:
  name: Str
  meetings: [Int]

  def busy?(hour: Int) -> Bool = meetings.contains?(hour)

struct Room:
  name: Str
  opens: Int
  closes: Int

  def free_slots(cal: Calendar) -> Iterator[Str]:
    for h in opens...closes:
      yield "#{name} #{h}:00" if not cal.busy?(h)

def main:
  ana = Person(name: "ana", meetings: [9, 11])
  room = Room(name: "Oak", opens: 9, closes: 13)
  for slot in room.free_slots(ana):
    puts slot
