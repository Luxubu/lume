# b14: A plain function (no `yield`) that gives `Iterator[Int]` by handing back
#   a chain: its result, kept in a local, is used up by its first walk
#   like a generator's, rather than being a list as a bound chain is.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `p` is a generator, and it is used up here, so it cannot be used after
#   --> corpus/m78/b14_iter_fn_twice.lume:17:8
#    |
# 17 |   puts p.sum
#    |        ^
#   help: a generator hands out each item once: to walk the items twice, keep them with `.to_list` first

def picks(xs: [Int]) -> Iterator[Int] = xs.filter { |x| x > 1 }

def main:
  p = picks([1, 2, 3])
  puts p.sum
  puts p.len
