# b06: `-> Iterator[T]` on plain functions without `yield`, giving back a list
#   literal, a chain over a list, a range, a struct with `next`, a chain
#   over another such result, another generator, and a generic list. Each
#   result moved along with `next` on a `var` and then walked by a chain
#   or `for`, which carries on from there; one handed to an `Iterator[Int]`
#   parameter.
# Meant to RUN.
# EXPECTED OUTPUT:
# Some(5)
# [6, 7]
# Some(3)
# 3
# Some(1)
# Some(1)
# [2, 2]
# Some(1)
# [3, 4]
# [2, 3]
# Some(4)
# 5
# 6
# 6
# zzz

struct Down:
  n: Int

  def next(var self) -> Int?:
    if n == 0:
      return None
    n -= 1
    Some(n + 1)

def from_list -> Iterator[Int] = [5, 6, 7]
def from_chain(xs: [Int]) -> Iterator[Int] = xs.map { |x| x + 1 }
def from_range(n: Int) -> Iterator[Int] = 1..n
def from_struct(n: Int) -> Iterator[Int] = Down(n: n)

def doubled_twice(n: Int) -> Iterator[Int]:
  for x in from_range(n):
    yield x
    yield x

def from_gen(n: Int) -> Iterator[Int] = doubled_twice(n)
def repeat3[T](x: T) -> Iterator[T] = [x, x, x]
def total(xs: Iterator[Int]) -> Int = xs.sum

def main:
  var a = from_list()
  puts a.next
  puts a.to_list
  var b = from_struct(3)
  puts b.next
  puts b.sum
  var c = from_gen(2)
  puts c.next
  puts c.next
  puts c.to_list
  var d = from_range(4)
  puts d.next
  puts d.skip(1).to_list
  puts from_chain([1, 2]).to_list
  var e = from_chain([3, 4, 5])
  puts e.next
  for x in e:
    puts x
  puts total(from_range(3))
  puts repeat3("z").join("")
