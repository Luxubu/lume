# a02_log_summary: a log summariser. A generator reads the lines of a log,
# splits each into fields and yields an `Event` built from the pieces; the
# log text is a `var` cleared once the events are listed. Probes: items of
# a split kept in struct fields that outlive the line and the text;
# `.slice` of a kept field used as a `group_by` key; a tally map keyed by a
# field; a set of messages; `max_by` over a map from `group_by`; a list
# pattern with text literals over a field's own split.
# Meant to RUN.
# EXPECTED OUTPUT:
# 7 events from 8 lines
# Event(time: "09:00:01", level: "INFO", source: "auth", text: "login ann")
# INFO  3
# WARN  1
# ERROR 3
# auth: 09:01, 09:04
# web: 09:02
# repeat: bad password for bo
# busiest minute 09:00: 2
# 09:00:01 ann logged in
# 09:01:15 bo failed
# 09:03:10 cy logged in
# 09:04:45 bo failed
# log now: []
# last: Event(time: "09:04:45", level: "ERROR", source: "auth", text: "bad password for bo")

struct Event:
  time: Str
  level: Str
  source: Str
  text: Str

def events(log: Str) -> Iterator[Event]:
  for line in log.lines:
    parts = line.split(" ")
    if parts.len >= 4:
      yield Event(time: parts.at(0), level: parts.at(1), source: parts.at(2), text: parts.skip(3).join(" "))

def main:
  var log = """
    09:00:01 INFO auth login ann
    09:00:07 WARN disk 81% full
    09:01:15 ERROR auth bad password for bo
    09:02:00 INFO web GET /index
    09:02:30 ERROR web timeout after 30s
    garbage
    09:03:10 INFO auth login cy
    09:04:45 ERROR auth bad password for bo
    """
  line_count = log.lines.len
  evs = events(log).to_list
  log = ""
  puts "#{evs.len} events from #{line_count} lines"
  puts evs.at(0)

  var by_level: {Str: Int} = {}
  for e in evs:
    by_level[e.level] = by_level[e.level].or(0) + 1
  for level, n in by_level:
    puts "#{level.pad_right(5)} #{n}"

  errors = evs.filter { |e| e.level == "ERROR" }.to_list
  for source, es in errors.group_by { |e| e.source }:
    minutes = es.map { |e| e.time.slice(0, 5) }.join(", ")
    puts "#{source}: #{minutes}"

  var seen: {Str} = {}
  for e in errors:
    puts "repeat: #{e.text}" unless seen.add(e.text)

  match evs.group_by { |e| e.time.slice(0, 5) }.max_by { |m, es| es.len }:
    Some((m, es)) -> puts "busiest minute #{m}: #{es.len}"
    None -> puts "no events"

  for e in evs:
    match e.text.split:
      ["login", who] -> puts "#{e.time} #{who} logged in"
      ["bad", "password", "for", who] -> puts "#{e.time} #{who} failed"
      _ -> ()

  puts "log now: [#{log}]"
  puts "last: #{evs.last.or(evs.at(0))}"
