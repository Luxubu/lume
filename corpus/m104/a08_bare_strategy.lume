# a08 — a field-less strategy struct handed to a function by its bare name,
# `Formal` instead of `Formal()`. A struct with no fields is still made with
# `()`, so `lume check` refuses the argument, pointing at the name.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `Formal` is a type; construct one with `Formal()`
#   --> corpus/m104/a08_bare_strategy.lume:23:16
#    |
# 23 |   puts welcome(Formal, ["Ada", "Grace"])
#    |                ^

interface Greeting:
  def greet(name: Str) -> Str

struct Formal:
  def greet(name: Str) -> Str = "Good evening, #{name}."

def welcome(g: Greeting, guests: [Str]) -> Str = guests
  .map { |n| g.greet(n) }
  .join(" ")

def main:
  puts welcome(Formal, ["Ada", "Grace"])
