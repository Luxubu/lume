# b13: a field-less struct written without `()` inside a list literal, next
# to one written with them. The bare name is the type, not a value.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `Marker` is a type; construct one with `Marker()`
#   --> corpus/m104/b13_marker_no_parens.lume:14:19
#    |
# 14 |   ms = [Marker(), Marker]
#    |                   ^

struct Marker

def main:
  ms = [Marker(), Marker]
  puts ms
