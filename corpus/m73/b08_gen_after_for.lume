# Probes: a generator walked by a `for` and then asked for its `len`: the
# `for` uses it up, so the error points at the `g` in the `for`.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `g` is a generator, and it is used up here, so it cannot be used after
#   --> corpus/m73/b08_gen_after_for.lume:18:12
#    |
# 18 |   for x in g:
#    |            ^
#   help: a generator hands out each item once: to walk the items twice, keep them with `.to_list` first

def evens(n: Int) -> Iterator[Int]:
  for i in 0..n:
    yield i if i % 2 == 0

def main:
  g = evens(6)
  for x in g:
    puts x
  puts g.len
