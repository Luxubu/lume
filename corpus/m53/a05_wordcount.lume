# a05_wordcount: word counts with sets and a map. Text is cleaned character
# by character (`out = out + c`, a `Str + Char`), a top-level constant set
# is read in a loop and in a block, `seen.add` answers whether a word is
# new, a tally map is replaced by its own `reject`, and the word list is
# read again at the end after everything has been built from it.
# Meant to RUN.
# EXPECTED OUTPUT:
# 14
# {"cat", "hat", "bat", "end"}
# {"cat"}
# {"cat": 3, "hat": 1, "bat": 1, "end": 1}
# 3
# true
# {"bat"}
# ["a", "bat", "and", "a", "rat"]
# Bat(1) Cat(3) End(1) Hat(1)
# 14 words, 8 distinct

STOP = {"the", "a", "and", "of"}

def clean(w: Str) -> Str:
  var out = ""
  for c in w.chars:
    if c.alpha?:
      out = out + c
  out

def words_of(text: Str) -> [Str]:
  text.downcase.split.map { |w| clean(w) }.filter { |w| not w.empty? }.to_list

def main:
  text = "The cat and the hat. A cat, a bat; the end of the cat!"
  words = words_of(text)
  puts words.len

  var seen: {Str} = {}
  var dups: {Str} = {}
  for w in words:
    next if STOP.contains?(w)
    if not seen.add(w):
      dups.add(w)
  puts seen
  puts dups

  var counts: {Str: Int} = {}
  for w in words:
    counts[w] = counts[w].or(0) + 1
  counts = counts.reject { |w, n| STOP.contains?(w) }
  puts counts

  singles = counts.filter { |w, n| n == 1 }.keys.to_set
  puts singles.len
  puts singles == seen.diff(dups)

  other = words_of("A bat and a rat")
  common = seen.intersect(other.to_set)
  puts common
  puts other

  var line = ""
  for w in seen.sort:
    line = line + w.capitalize + "(#{counts[w].or(0)}) "
  puts line.trim
  puts "#{words.len} words, #{words.to_set.len} distinct"
