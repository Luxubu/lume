# Int/Float max min clamp pow even? odd?, on fields and chained.
struct Stats:
  lo: Int
  hi: Int

  def widen(var self, n: Int):
    lo = lo.min(n)
    hi = hi.max(n)

  def span -> Int = hi - lo
  def clamp_to(n: Int) -> Int = n.clamp(lo, hi)

def main:
  var s = Stats(0, 0)
  for n in [5, -3, 12, 7]:
    s.widen(n)
  puts "#{s.lo} #{s.hi} #{s.span}"
  puts s.clamp_to(100)
  puts s.clamp_to(-50)
  puts s.clamp_to(4)
  puts((1..10).to_list.filter(_.even?).to_list)
  puts((1..10).to_list.filter(_.odd?).map { |n| n.pow(2) }.to_list)
  puts 2.pow(0)
  neg = -3
  puts neg.abs.max(2)
  puts 3.max(7).min(5).clamp(0, 4)
  puts 1.5.clamp(0.0, 1.0)
  puts 2.0.pow(0.5)
  puts [3, 9, 1].max.map { |m| m.pow(2) }
  puts [1, 2, 3].map { |x| x.max(2) }.sum
  puts neg.even?
  puts 0.even?
  puts neg.pow(3)
  puts 10.clamp(20, 5)
