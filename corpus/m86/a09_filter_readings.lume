# Probes: a poller whose caller reaches for a chain method straight on the
# async generator, `readings().filter { .. }`, the way it would on a list or
# a plain generator. Chains over an async generator are not there yet; the
# docs say to keep the items with `.to_list` first.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `async Iterator[Int]` values cannot take a block; only lists and ranges can
#   --> corpus/m86/a09_filter_readings.lume:20:20
#    |
# 20 |   high = readings().filter { |r| r > 50 }.to_list
#    |                    ^
#   help: walk it with `for` in async code, or keep its items with `.to_list` and chain over the list

async def readings -> Iterator[Int]:
  for r in [20, 70, 40, 90]:
    await Time.sleep(1)
    yield r

async def main:
  high = readings().filter { |r| r > 50 }.to_list
  puts high
