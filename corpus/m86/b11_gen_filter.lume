# Probes: `filter` with a block on an async generator held in a `var`,
# followed by `.len`: refused, as `map` is.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `async Iterator[Int]` values cannot take a block; only lists and ranges can
#   --> corpus/m86/b11_gen_filter.lume:18:12
#    |
# 18 |   total = g.filter { |x| x > 1 }.len
#    |            ^
#   help: walk it with `for` in async code, or keep its items with `.to_list` and chain over the list

async def nums -> Iterator[Int]:
  yield 1
  yield 2

async def main:
  var g = nums()
  total = g.filter { |x| x > 1 }.len
  puts total
