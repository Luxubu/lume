# b04 — names bound by patterns and never read: a name bound in both
# alternatives of `|` (one warning, at the first alternative's name, or
# two?), a name from a destructured tuple `(whole, rest) = ...` (warned as
# a local or as a pattern name, and where is the caret?), and a name in a
# tuple pattern inside `match`.
# Meant to RUN.
# EXPECTED OUTPUT:
# 7
# has a size
# a dot
# 1
# EXPECTED STDERR:
# warning: `size` is bound by the pattern but never used
#   --> corpus/m110/b04_patterns_or_tuple.lume:39:12
#    |
# 39 |     Circle(size) | Square(size) -> "has a size"
#    |            ^
#   help: write `_` in its place, or name it `_size`
# warning: `rest` is given a value but never used
#   --> corpus/m110/b04_patterns_or_tuple.lume:43:3
#    |
# 43 |   (whole, rest) = (7, 2)
#    |   ^
#   help: use it, or name it `_rest` to say it is not meant to be
# warning: `word` is bound by the pattern but never used
#   --> corpus/m110/b04_patterns_or_tuple.lume:48:9
#    |
# 48 |     (n, word) -> puts n
#    |         ^
#   help: write `_` in its place, or name it `_word`

enum Shape:
  Circle(r: Float)
  Square(side: Float)
  Dot

def kind(s: Shape) -> Str:
  match s:
    Circle(size) | Square(size) -> "has a size"
    Dot -> "a dot"

def main:
  (whole, rest) = (7, 2)
  puts whole
  puts kind(Square(2.0))
  puts kind(Dot)
  match (1, "one"):
    (n, word) -> puts n
