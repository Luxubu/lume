# commit.lume — the model. A commit has a kind, an optional scope and a
# subject. `rank` is here because the section order is a property of the
# kind, not of the renderer.

pub enum Kind:
  Feature
  Fix
  Docs
  Chore
  Unknown(word: Str)

  def heading -> Str = match self:
    Feature    -> "Added"
    Fix        -> "Fixed"
    Docs       -> "Documentation"
    Chore      -> "Housekeeping"
    Unknown(w) -> "Other (#{w})"

  def rank -> Int = match self:
    Feature    -> 0
    Fix        -> 1
    Docs       -> 2
    Chore      -> 3
    Unknown(_) -> 4

pub struct Commit:
  hash: Str
  kind: Kind
  scope: Str?
  text: Str

  def label -> Str = match scope:
    Some(s) -> "#{s}: #{text}"
    None    -> text
