# r10 — a git-log analyser in five files: the model, the line format, the
# aggregation, the table layout, and this driver. The same three-column
# report is produced three times by handing `stats.by` a different key
# block, which is why aggregation and layout are separate files.
#
# Probes: a block parameter (`pick: (record.Change) -> Str`) crossing a
# module boundary and called inside a loop; the `_` shorthand supplied for
# it from main three ways — a field (`_.month`), a field (`_.author`) and
# a method (`_.area`); three parallel `{Str: Int}` maps grown together;
# column widths computed from data in a file that never sees the data's
# type except through one imported struct; `?` unwinding out of a
# `for` loop in an imported module.
#
# Meant to RUN.
#
# Assumptions: `pad_right(n)` pads on the right and `pad(n)` pads on the
# left — the README lists both for Str but says which for neither, and
# `examples/collections.lume`'s `w.pad_right(6)` is where I get the
# direction. `Str.sort` orders by code point, which is why "(root)" comes
# before "compiler". Nothing prints a list, map, Float or optional
# directly.
#
# EXPECTED OUTPUT:
# 9 changes, +565 -287 (net 278)
# author  commits  added  removed    net
# ana           4    230      135     95
# bo            3     55       22     33
# cy            2    280      130    150
#
# area      commits  added  removed    net
# (root)          2     50        5     45
# compiler        3    260      250     10
# docs            2     45       20     25
# examples        1    200       10    190
# tests           1     10        2      8
#
# month    commits  added  removed    net
# 2026-01        2    150       45    105
# 2026-02        3    275      115    160
# 2026-03        4    140      127     13
#
# error: line 1: expected 5 fields, got 3

import record
import reader
import stats
import table

def main -> () or Error:
  log = [
    "2026-01-14 ana 120 40 compiler/parser.rs",
    "2026-01-14 bo 30 5 docs/tour.md",
    "2026-02-03 ana 60 90 compiler/codegen.rs",
    "2026-02-03 cy 200 10 examples/site/gen.lume",
    "2026-02-19 bo 15 15 docs/tour.md",
    "2026-03-01 ana 45 0 README.md",
    "2026-03-01 cy 80 120 compiler/parser.rs",
    "2026-03-07 bo 10 2 tests/run.sh",
    "2026-03-07 ana 5 5 oops",
  ]

  cs: [record.Change] = reader.changes(log)?
  plus = cs.sum { |c| c.added }
  minus = cs.sum { |c| c.removed }
  delta = cs.sum { |c| c.net }
  puts "#{cs.len} changes, +#{plus} -#{minus} (net #{delta})"

  for l in table.render("author", stats.by(cs, _.author)):
    puts l
  puts ""
  for l in table.render("area", stats.by(cs, _.area)):
    puts l
  puts ""
  for l in table.render("month", stats.by(cs, _.month)):
    puts l
  puts ""

  match reader.changes(["2026-03-07 bo 10"]):
    Ok(_)    -> puts "unexpected"
    Error(e) -> puts "error: #{e.message}"
