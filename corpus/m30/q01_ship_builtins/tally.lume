# tally.lume — a library that ships five conformances, one per built-in
# shape: a list, a set, a map, a pair and an optional. An `extend` has no
# name, so none of these is marked `pub`; they travel with `import tally`.

pub interface Tally[T]:
  def parts -> [T]

  def bulk -> Int = parts.len
  def shown -> Str = parts.map { |x| "#{x}" }.to_list.join("|")
  def blank? -> Bool = bulk == 0

extend [T] with Tally[T]:
  def parts -> [T] = self

extend {T} with Tally[T]:
  def parts -> [T] = self.to_list

extend {K: V} with Tally[V]:
  def parts -> [V] = self.values.to_list

extend (A, B) with Tally[B]:
  def parts -> [B] = [self.1]

extend T? with Tally[T]:
  def parts -> [T]:
    match self:
      Some(x) -> [x]
      None    -> []

# One bounded helper that reaches every one of them.
pub def wider[A: Tally[Str], B: Tally[Str]](a: A, b: B) -> Str:
  if a.bulk >= b.bulk:
    "left:#{a.shown}"
  else:
    "right:#{b.shown}"
