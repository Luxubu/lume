# b05 — probes: a `() or Error` call that ends a `match` arm is the
# function's value only when the `match` ends the function. Here a line
# follows the `match`, so the arm's call is a failure nothing looks at.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `save` can fail, and nothing here looks at whether it did
#   --> corpus/m131/b05_arm_not_last.lume:19:16
#    |
# 19 |     Some(n) -> save(n)
#    |                ^
#   help: pass the failure on with `?`, handle it with `match`, or say you mean to drop it: `_ = ...`

def save(name: Str) -> () or Error:
  return Error("no name") if name.empty?
  puts "saved #{name}"

def store(names: [Str]) -> () or Error:
  match names.first:
    Some(n) -> save(n)
    None -> save("nobody")
  puts "stored"

def main -> () or Error:
  store(["ada"])?
