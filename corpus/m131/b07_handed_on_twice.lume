# b07 — probes: a generator handed to a parameter `xs: Iterator[Int]` is
# moved in, so handing the same name on a second time is refused, at the
# first hand-over.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `e` is a generator, and it is used up here, so it cannot be used after
#   --> corpus/m131/b07_handed_on_twice.lume:21:14
#    |
# 21 |   puts total(e)
#    |              ^
#   help: a generator hands out each item once: to walk the items twice, keep them with `.to_list` first

def total(xs: Iterator[Int]) -> Int = xs.sum

def evens -> Iterator[Int]:
  for n in 0..6:
    yield n if n % 2 == 0

def main:
  e = evens()
  puts total(e)
  puts total(e)
