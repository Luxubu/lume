# b06 — probes: a `yield` inside an `if` in a `for`, and a loop with two
# `yield`s. The first does its work for each item it looks at, up to the
# one that fills `take(2)`; the second runs what lies between its yields
# only when the second item of a turn is asked for.
# Meant to RUN.
# EXPECTED OUTPUT:
# look 1
# look 2
# look 3
# [1, 3]
# open 1
# (between 1)
# close 1
# open 2
# (between 2)
# close 2
# (between 1)
# ["open 1", "close 1", "open 2"]

def look(x: Int):
  puts "look #{x}"

def odd_ones(xs: [Int]) -> Iterator[Int]:
  for x in xs:
    look(x)
    if x % 2 == 1:
      yield x

def courses(n: Int) -> Iterator[Str]:
  var i = 1
  while i <= n:
    yield "open #{i}"
    puts "(between #{i})"
    yield "close #{i}"
    i += 1

def main:
  puts odd_ones([1, 2, 3, 4, 5]).take(2).to_list
  for c in courses(2):
    puts c
  puts courses(3).take(3).to_list
