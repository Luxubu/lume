# b09_next_not_var_self: a `next` that does not take `var self` (it only
# reads, so its body is legal) and does give an optional. The docs say a
# `next` of another shape is just a method: calling it by hand is fine, and
# a `for` over the type says what is wrong. This probes the help line for
# the missing `var self` (only the wrong-return-type help is shown in
# examples/errors/next_wrong_shape).
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: cannot loop over a `Ones`
#   --> corpus/m69/b09_next_not_var_self.lume:24:12
#    |
# 24 |   for x in o:
#    |            ^
#   help: `Ones`'s `next` does not take `var self`; to loop over it, write `def next(var self) -> T?`

struct Ones:
  n: Int

  def next -> Int? = Some(n)

def main:
  o = Ones(n: 1)
  puts o.next
  for x in o:
    puts x
