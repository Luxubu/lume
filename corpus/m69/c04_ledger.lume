# c04_ledger — a bank ledger whose accounts are an interface with a
# required `var self` method.
# Probes: an interface `Account` with a required `def apply(var self, ...)
# -> () or Error` and a default that reads the required methods; two structs
# that fit it; a generic `[A: Account]` function taking `var acct: A`; a
# `[Account]` list built with `push` and changed item by item with
# `for var`; a `var [Account]` parameter; an enum of moves taken apart with
# `match`, `?` passing failures up, and a refund on the failure path; a
# `def items -> [(Str, Int)]` type looped over with two names and given
# two-name blocks.
# Meant to RUN.
# EXPECTED OUTPUT:
# []
# ["cy: no more withdrawals"]
# cy           7.50
# ok   Deposit(who: "ana", cents: 2500)
# ok   Withdraw(who: "bo", cents: 500)
# FAIL ana: over the 1000 overdraft
# ok   Transfer(src: "ana", dst: "bo", cents: 8000)
# ok   Withdraw(who: "bo", cents: 100)
# FAIL bo: no more withdrawals
# FAIL no account dee
# FAIL no account zed (refunded)
# ok   Deposit(who: "bo", cents: 1)
# ana         -5.00
# bo          94.01
# total 8901
# ana failed 2
# bo failed 1
# dee failed 1
# 3 names, 4 failures
# ["ana"]

interface Account:
  def name -> Str
  def balance -> Int
  def apply(var self, amount: Int) -> () or Error

  def show -> Str = "#{name.pad_right(8)}#{(balance.to_float / 100.0).decimals(2).pad(9)}"

struct Checking:
  owner: Str
  cents: Int
  limit: Int

  def name -> Str = owner
  def balance -> Int = cents

  def apply(var self, amount: Int) -> () or Error:
    if cents + amount < 0 - limit:
      return Error("#{owner}: over the #{limit} overdraft")
    cents += amount

struct Savings:
  owner: Str
  cents: Int
  withdrawals: Int

  def name -> Str = owner
  def balance -> Int = cents

  def apply(var self, amount: Int) -> () or Error:
    if amount < 0:
      if withdrawals == 2:
        return Error("#{owner}: no more withdrawals")
      if cents + amount < 0:
        return Error("#{owner}: only #{cents} left")
      withdrawals += 1
    cents += amount

enum Move:
  Deposit(who: Str, cents: Int)
  Withdraw(who: Str, cents: Int)
  Transfer(src: Str, dst: Str, cents: Int)

  def actor -> Str:
    match self:
      Deposit(w, _) -> w
      Withdraw(w, _) -> w
      Transfer(s, _, _) -> s

def run[A: Account](var acct: A, moves: [Int]) -> [Str]:
  var errs: [Str] = []
  for m in moves:
    match acct.apply(m):
      Ok(_) -> ()
      Error(e) -> errs.push(e.message)
  errs

def deliver(var all: [Account], who: Str, amount: Int) -> () or Error:
  for var a in all:
    if a.name == who:
      return a.apply(amount)
  return Error("no account #{who}")

def perform(var all: [Account], m: Move) -> () or Error:
  match m:
    Deposit(w, c) -> deliver(all, w, c)?
    Withdraw(w, c) -> deliver(all, w, 0 - c)?
    Transfer(s, d, c) ->
      deliver(all, s, 0 - c)?
      match deliver(all, d, c):
        Ok(_) -> ()
        Error(e) ->
          deliver(all, s, c)?
          return Error("#{e.message} (refunded)")

struct Statement:
  lines: {Str: Int}

  def items -> [(Str, Int)] = lines.to_list.sort_by { |k, v| 0 - v }

def total(xs: [Account]) -> Int = xs.map { |a| a.balance }.sum

def main:
  var ch = Checking(owner: "zoe", cents: 100, limit: 0)
  puts run(ch, [50, 0 - 150])
  var sv = Savings(owner: "cy", cents: 1000, withdrawals: 0)
  puts run(sv, [0 - 100, 0 - 200, 0 - 300, 50])
  puts sv.show

  var all: [Account] = []
  all.push(Checking(owner: "ana", cents: 5000, limit: 1000))
  all.push(Savings(owner: "bo", cents: 2000, withdrawals: 0))

  moves = [Deposit("ana", 2500), Withdraw("bo", 500), Transfer("ana", "bo", 9000), Transfer("ana", "bo", 8000), Withdraw("bo", 100), Transfer("bo", "ana", 100), Withdraw("dee", 5), Transfer("ana", "zed", 300), Deposit("bo", 1)]
  var fails: {Str: Int} = {}
  for m in moves:
    match perform(all, m):
      Ok(_) -> puts "ok   #{m}"
      Error(e) ->
        puts "FAIL #{e.message}"
        fails[m.actor] = fails[m.actor].or(0) + 1

  for a in all:
    puts a.show
  puts "total #{total(all)}"

  st = Statement(lines: fails)
  for who, n in st:
    puts "#{who} failed #{n}"
  puts "#{st.len} names, #{st.map { |who, n| n }.sum} failures"
  puts st.filter { |who, n| n > 1 }.map { |who, n| who }.to_list
