# b05_items_shadow_bounds: `def items -> [T]` edges. A FIELD named like a
# list method (`sum`) and an own METHOD named like one (`first`, with a
# different return type) come before the list's; `max`, `last`, `len`,
# `to_list`, `enumerate` still come from `items`; a chain's `sum` is the
# list's; inside a generic `[C: Iterable[Int]]` function, `c.sum` is the
# list's sum, not the field. A set (with a duplicate in its literal) and a
# list passed to `Iterable` bounds, including `Iterable[Str]` with `max`.
# Meant to RUN.
# EXPECTED OUTPUT:
# 100
# -1
# Some(5)
# Some(5)
# 3
# [1, 3, 5]
# 18
# 9
# 9
# 6
# Some("pear")
# Some("c")
# 0:1
# 1:3
# 2:5

struct Scores:
  vals: [Int]
  sum: Int

  def items -> [Int] = vals.sort

  def first -> Int = 0 - 1

def total[C: Iterable[Int]](c: C) -> Int:
  var t = 0
  for x in c:
    t += x
  t

def bound_sum[C: Iterable[Int]](c: C) -> Int = c.sum

def biggest[C: Iterable[Str]](c: C) -> Str? = c.max

def main:
  s = Scores(vals: [5, 1, 3], sum: 100)
  puts s.sum
  puts s.first
  puts s.max
  puts s.last
  puts s.len
  puts s.to_list
  puts s.map { |x| x * 2 }.sum
  puts total(s)
  puts bound_sum(s)
  puts total({4, 4, 2})
  puts biggest({"pear", "fig"})
  puts biggest(["a", "c", "b"])
  for i, x in s.enumerate:
    puts "#{i}:#{x}"
