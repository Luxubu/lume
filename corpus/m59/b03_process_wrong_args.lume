# b03: Process.run given its arguments as one string, the way a shell line
# is written, instead of a `[Str]`. The second argument has the wrong type.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `Process.run` takes a `[Str]`, but this is a `Str`
#   --> corpus/m59/b03_process_wrong_args.lume:28:38
#    |
# 28 |   (code, out, _) = Process.run("sh", "-c 'echo hi'")?
#    |                                      ^
#   help: the arguments go in a list, one item each: `["-c", "echo hi"]`
#
# `lume check --json corpus/m59/b03_process_wrong_args.lume` prints:
# {
#   "diagnostics": [
#     {
#       "col": 38,
#       "file": "corpus/m59/b03_process_wrong_args.lume",
#       "help": "the arguments go in a list, one item each: `[\"-c\", \"echo hi\"]`",
#       "line": 28,
#       "message": "`Process.run` takes a `[Str]`, but this is a `Str`",
#       "severity": "error"
#     }
#   ],
#   "ok": false
# }

def main -> () or Error:
  (code, out, _) = Process.run("sh", "-c 'echo hi'")?
  puts "#{code} #{out.trim}"
