# a09_hex_dump — a first-week guess at a crate function: `hex.dump`, as a
# hexdump tool would call it. The `hex` crate has `encode`, not `dump`, so
# the call is refused, with the command that lists what the crate offers.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: crate `hex` has no `dump`
#   --> corpus/m116/a09_hex_dump.lume:19:15
#    |
# 19 |   dumped = hex.dump(token)
#    |               ^
#   help: `lume crate <file> hex` lists what the crate offers

import rust.hex = "0.4"
import rust.urlencoding = "2"

def main:
  token = urlencoding.encode("tea for two")
  puts token
  dumped = hex.dump(token)
  puts "#{token} is #{dumped}"
