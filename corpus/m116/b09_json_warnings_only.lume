# b09 — `lume check --json` on a file with warnings and no error: `ok` stays
# true, each warning has its `help`, and the exit status is 0.
# Run with `lume check --json corpus/m116/b09_json_warnings_only.lume`.
# Meant to RUN.
# EXPECTED OUTPUT:
# {
#   "diagnostics": [
#     {
#       "col": 17,
#       "file": "corpus/m116/b09_json_warnings_only.lume",
#       "help": "fine in tests and quick scripts; elsewhere use `match`, `?` or `.or(default)`",
#       "line": 30,
#       "message": "`!` stops the program if the value is missing or an error",
#       "severity": "warning"
#     },
#     {
#       "col": 3,
#       "file": "corpus/m116/b09_json_warnings_only.lume",
#       "help": "use it, or name it `_spare` to say it is not meant to be",
#       "line": 31,
#       "message": "`spare` is given a value but never used",
#       "severity": "warning"
#     }
#   ],
#   "ok": true
# }
# EXPECTED EXIT: 0

def main:
  n = "7".to_int!
  spare = n * 2
  puts n
