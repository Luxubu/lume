# b04 — the waiting methods on a `Child`'s `lines` (and `error_lines`):
# `count`, `sum` with a block, `fold`, `find`, `any?` on output that never
# ends, `each` changing names, `first` on no output at all.
# Meant to RUN.
# EXPECTED OUTPUT:
# 3
# 0
# 8
# ag
# ["BETA", "DELTA"]
# 2
# Some("y")
# true
# -1
# 2 two
# None

async def main -> () or Error:
  a = Process.spawn("printf", ["3\n1\n4\n1\n5\n"])?
  puts a.lines.count { |l| l.to_int.or(0) > 2 }
  puts await a.wait
  b = Process.spawn("printf", ["3\n1\n4\n"])?
  puts b.lines.sum { |l| l.to_int.or(0) }
  # both outputs read, standard output first
  c = Process.spawn("sh", ["-c", "echo alpha; echo beta >&2; echo gamma; echo delta >&2; exit 2"])?
  puts c.lines.fold("") { |acc, l| acc + l.slice(0, 1) }
  puts c.error_lines.map { |l| l.upcase }.to_list
  puts await c.wait
  d = Process.spawn("printf", ["x\ny\nz\n"])?
  puts d.lines.find { |l| l == "y" }
  # never ends by itself: any? stops at its answer, then it is stopped
  e = Process.spawn("sh", ["-c", "while true; do echo y; done"])?
  puts e.lines.any? { |l| l == "y" }
  e.kill
  puts await e.wait
  var n = 0
  var last = ""
  f = Process.spawn("printf", ["one\ntwo\n"])?
  f.lines.each do |l|
    n += 1
    last = l
  puts "#{n} #{last}"
  g = Process.spawn("printf", [""])?
  puts g.lines.first
  ()
