# b02 — `count` with a block, `sum` of Ints and Floats, with and without a
# block, on empty sequences, after chains; `fold` with another type.
# Meant to RUN.
# EXPECTED OUTPUT:
# 3
# 14
# 26
# 0
# 3.75
# 0.0
# 2.0
# 1.5
# 120
# 2
# 2
# 4
# start
# 1;2;3;

async def nums(xs: [Int]) -> Iterator[Int]:
  for x in xs:
    await Time.sleep(1)
    yield x

async def floats(xs: [Float]) -> Iterator[Float]:
  for x in xs:
    yield x

async def main:
  puts nums([3, 1, 4, 1, 5]).count { |n| n > 2 }
  puts nums([3, 1, 4, 1, 5]).sum
  puts nums([3, 1, 4]).sum { |n| n * n }
  puts nums([]).sum
  puts floats([1.5, 2.25]).sum
  puts floats([]).sum
  puts floats([0.5, 0.5]).sum { |f| f * 2.0 }
  # a block that gives a Float, over Ints
  puts nums([1, 2]).sum { |n| n.to_float / 2.0 }
  puts nums([1, 2, 3, 4, 5, 6]).filter { |n| n % 2 == 0 }.map { |n| n * 10 }.sum
  puts nums([1, 2, 3, 4, 5]).skip(1).take(3).count { |n| n > 2 }
  puts nums([5, 6, 7]).enumerate.count { |i, n| i + n > 6 }
  puts nums([1, 2, 3]).fold(10) { |acc, n| acc - n }
  puts nums([]).fold("start") { |acc, n| acc + "#{n}" }
  puts nums([1, 2, 3]).map { |n| "#{n}" }.fold("") { |acc, s| acc + s + ";" }
