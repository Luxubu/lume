# a01 — a temperature log read from mixed-unit text.
# Probes: functions of a type used as named constructors (`Temp.from_f`,
# `Temp.from_c`), one that can fail (`Temp.parse -> Temp or Error`) and uses
# `?` inside, bare-name calls between a type's own functions, a type's
# function handed over as a block (`fs.map(Temp.from_f)`), `count`/`max_by`
# with the `_` shorthand, `avg` on a chain, and `?` in `main -> () or Error`.
# Meant to RUN.
# EXPECTED OUTPUT:
# skip: no unit on `hot`
# skip: no unit on `12.5`
# 20.0C, 25.0C, 35.0C, 30.0C
# hot days: 2
# 0.0C 100.0C 37.0C
# warmest: 35.0C
# average: 27.50
# 50.0

struct Temp:
  celsius: Float

  def self.from_f(f: Float) -> Temp = Temp(celsius: (f - 32.0) * 5.0 / 9.0)
  def self.from_c(c: Float) -> Temp = Temp(celsius: c)

  def self.parse(s: Str) -> Temp or Error:
    t = s.trim
    if t.ends_with?("F"):
      return from_f(t.replace("F", "").to_float?)
    if t.ends_with?("C"):
      return from_c(t.replace("C", "").to_float?)
    Error("no unit on `#{t}`")

  def fahrenheit -> Float = celsius * 9.0 / 5.0 + 32.0
  def show -> Str = "#{celsius.decimals(1)}C"
  def hot? -> Bool = celsius >= 30.0

def main -> () or Error:
  readings = ["68F", " 25C", "95F", "30C", "hot", "12.5"]
  var good: [Temp] = []
  for r in readings:
    match Temp.parse(r):
      Ok(t)    -> good.push(t)
      Error(e) -> puts "skip: #{e.message}"

  puts good.map(_.show).join(", ")
  puts "hot days: #{good.count(_.hot?)}"

  # a type's function where a block is wanted, like a function's name
  fs = [32.0, 212.0, 98.6]
  puts fs.map(Temp.from_f).map(_.show).join(" ")

  warmest = good.max_by(_.celsius)
  puts "warmest: #{warmest.map(_.show).or("none")}"
  puts "average: #{good.map(_.celsius).avg.decimals(2)}"

  check = Temp.parse("50F")?
  puts check.fahrenheit
