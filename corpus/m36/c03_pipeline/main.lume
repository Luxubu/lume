# c03 — summary blocks for a few series; the helpers arrive by `pub import`
#
# Probes: `pub import m` and `pub import m as alias` re-exporting two modules
#   through a third, so main imports only `report` yet calls `stats.mean` and
#   `tx.rule`; a module-private helper called from a method of a pub struct;
#   an empty list as a constructor argument; `T?` results across modules.
#
# Meant to RUN.
#
# EXPECTED OUTPUT:
# latency
# ----------------
# count          5
# mean        14.4
# median      12.0
# spread        23
#
# retries
# ----------------
# count          4
# mean         1.0
# median       1.0
# spread         2
#
# empty
# ----------------
# count          0
# mean         n/a
# median       n/a
# spread         0
#
# overall mean 8.44 over 9 values
# -----

import report
import report.Series

def main:
  data = [
    Series(name: "latency", values: [12, 7, 30, 9, 14]),
    Series(name: "retries", values: [0, 2, 1, 1]),
    Series(name: "empty", values: []),
  ]
  for s in data:
    for line in s.lines:
      puts line
    puts ""

  all = data.flat_map { |s| s.values }.to_list
  overall = stats.mean(all).or(0.0)
  puts "overall mean #{overall.decimals(2)} over #{all.len} values"
  puts tx.rule(5)
