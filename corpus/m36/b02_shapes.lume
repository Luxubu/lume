# b02 — a small shape library behind one interface
#
# Probes: interface with two required methods and two defaults (one default
#   calling the others, plus `.decimals`); structural conformance with no
#   declaration; `extend Rect with Shape` supplying only a default override
#   and calling the struct's own method `square?` bare; a struct method
#   calling another method (`perimeter`) bare; `[Shape]` list annotation;
#   `max_by` over interface values; a function declared `-> Shape` whose
#   `if` branches are two different structs; calling a default directly on
#   a struct that never names the interface.
#
# Meant to RUN.
# (stdout below; the docs say a `[Shape]` of mixed types also prints a
#  "calls on its items go through a pointer" warning on stderr)
#
# EXPECTED OUTPUT:
# circle: area 3.0, perimeter 6.0
# rect: area 6.0, perimeter 10.0
# square: area 4.0, perimeter 8.0
# shape: area 24.0, perimeter 24.0
# total 37.0
# largest: shape
# big ones: rect,shape
# circle: area 12.0, perimeter 12.0
# square
# square
# 3.0

interface Shape:
  def area -> Float
  def perimeter -> Float

  def name -> Str = "shape"
  def summary -> Str =
    "#{name}: area #{area.decimals(1)}, perimeter #{perimeter.decimals(1)}"

struct Circle:
  r: Float

  def area -> Float = 3.0 * r * r
  def perimeter -> Float = 6.0 * r
  def name -> Str = "circle"

struct Rect:
  w: Float
  h: Float

  def area -> Float = w * h
  def perimeter -> Float = 2.0 * (w + h)
  def square? -> Bool = w == h

struct Triangle:
  a: Float
  b: Float
  c: Float

  def perimeter -> Float = a + b + c
  def area -> Float:
    s = perimeter / 2.0
    (s * (s - a) * (s - b) * (s - c)).sqrt

extend Rect with Shape:
  def name -> Str = if square?: "square" else: "rect"

def total_area(shapes: [Shape]) -> Float = shapes.map(_.area).sum

def largest(shapes: [Shape]) -> Str:
  match shapes.max_by { |s| s.area }:
    Some(s) -> s.name
    None    -> "none"

def pick(big: Bool) -> Shape:
  if big:
    Rect(10.0, 10.0)
  else:
    Circle(1.0)

def main:
  shapes: [Shape] = [Circle(1.0), Rect(2.0, 3.0), Rect(2.0, 2.0), Triangle(6.0, 8.0, 10.0)]
  for s in shapes:
    puts s.summary
  puts "total #{total_area(shapes)}"
  puts "largest: #{largest(shapes)}"
  puts "big ones: #{shapes.filter { |s| s.area > 5.0 }.map(_.name).join(",")}"

  puts Circle(2.0).summary
  puts Rect(5.0, 5.0).name
  puts pick(true).name
  puts pick(false).area
