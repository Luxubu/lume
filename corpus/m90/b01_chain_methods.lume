# Probes every chain method on an async sequence, chains of chains,
# `take(0)`, `skip` to and past the end, `take` on an endless sequence,
# and a two-name block after `enumerate`.
# Meant to RUN.
# EXPECTED OUTPUT:
# [10, 20, 30]
# [1, 3]
# [2]
# [1, 2]
# []
# []
# []
# [1, 2, 3]
# [(0, 1), (1, 2), (2, 3)]
# [9, 16]
# [0, 3, 5]
# [0, 1, 4]
# []
# [6, 7]

async def three -> Iterator[Int]:
  yield 1
  yield 2
  yield 3

async def naturals -> Iterator[Int]:
  var n = 0
  while true:
    yield n
    n += 1

async def main:
  puts three().map { |x| x * 10 }.to_list
  puts three().filter { |x| x != 2 }.to_list
  puts three().reject { |x| x != 2 }.to_list
  puts three().take_while { |x| x < 3 }.to_list
  puts three().take(0).to_list
  puts three().skip(3).to_list
  puts three().skip(7).to_list
  puts three().take(10).to_list
  puts three().enumerate.to_list
  puts naturals().skip(2).take(3).map { |n| n * n }.filter { |n| n > 4 }.to_list
  puts naturals().take_while { |n| n < 4 }.reject { |n| n == 1 }.enumerate.map { |p| p.0 + p.1 }.to_list
  puts naturals().enumerate.map { |i, n| i * n }.take(3).to_list
  puts naturals().map { |n| n + 1 }.take(0).to_list
  puts naturals().skip(5).take_while { |n| n < 8 }.skip(1).to_list
