# Probes the source of an async chain used after the chain took it.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `g` is a generator, and it is used up here, so it cannot be used after
#   --> corpus/m90/b12_source_after_chain.lume:17:7
#    |
# 17 |   c = g.map { |n| n + 1 }
#    |       ^
#   help: a generator hands out each item once: to walk the items twice, keep them with `.to_list` first

async def nums -> Iterator[Int]:
  yield 1
  yield 2

async def main:
  g = nums()
  c = g.map { |n| n + 1 }
  puts c.to_list
  puts g.to_list
