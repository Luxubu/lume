# Probes `extend` generators used through an interface: a parameter typed as
# the interface, a list of interface values (struct, `Str`, `[Int]`), a
# default built on the generator, and the default on a built-in directly.
# Meant to RUN.
# EXPECTED OUTPUT:
# to a,to b
# P,Q
# <3>,<4>
# ["to z"]
# ["M", "N"]
# ["<7>"]
# ["to z", "M", "<7>"]
# ["M"]
# none
# EXPECTED STDERR:
# warning: `ws` holds values of different types behind `Walk`, so calls on its items go through a pointer
#   --> corpus/m90/b07_extend_iface.lume:51:3
#    |
# 51 |   ws: [Walk] = [Path(stops: ["z"]), "m n", [7]]
#    |   ^
#   help: fine for most code; use a single concrete type or an enum if this is a hot loop

interface Walk:
  def steps -> Iterator[Str]
  def first_step -> Str = steps.first.or("none")

struct Path:
  stops: [Str]

extend Path with Walk:
  def steps -> Iterator[Str]:
    for s in stops:
      yield "to #{s}"

extend Str with Walk:
  def steps -> Iterator[Str]:
    for w in split(" "):
      yield w.upcase

extend [T] with Walk:
  def steps -> Iterator[Str]:
    for x in self:
      yield "<#{x}>"

def all_steps(w: Walk) -> Str = w.steps.join(",")

def main:
  puts all_steps(Path(stops: ["a", "b"]))
  puts all_steps("p q")
  puts all_steps([3, 4])
  ws: [Walk] = [Path(stops: ["z"]), "m n", [7]]
  for w in ws:
    puts w.steps.to_list
  puts ws.map { |w| w.first_step }.to_list
  puts ws.at(1).steps.take(1).to_list
  empty: [Int] = []
  puts empty.first_step
