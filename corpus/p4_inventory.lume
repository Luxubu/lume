# Struct-heavy inventory with methods and an interface.
interface Priced:
  def price -> Float
  def label -> Str
  def describe -> Str:
    "#{label} @ #{price}"

struct Item:
  name: Str
  unit: Float
  qty: Int

  def price -> Float = unit * qty.to_float
  def label -> Str = "#{name} x#{qty}"
  def restock(var self, n: Int):
    qty += n

struct Service:
  title: Str
  hours: Float
  rate: Float

  def price -> Float = hours * rate
  def label -> Str = title

struct Inventory:
  items: [Item]

  def add(var self, it: Item):
    items.push(it)

  def find(name: Str) -> Item? = items.find(_.name == name)

  def total -> Float = items.sum(_.price)

  def low_stock(limit: Int) -> [Str] = items.filter(_.qty < limit).map(_.name).to_list

def main:
  var inv = Inventory([])
  inv.add(Item("bolt", 0.25, 100))
  inv.add(Item("nut", 0.1, 3))
  inv.add(Item("gear", 12.5, 2))
  puts "total value: #{inv.total}"
  puts "low: #{inv.low_stock(5)}"
  match inv.find("gear"):
    Some(g) -> puts g.label
    None    -> puts "no gear"
  var first = inv.items[0].or(Item("none", 0.0, 0))
  first.restock(10)
  puts first.label
  puts inv.items[0]
  things: [Priced] = [Item("pin", 0.01, 1000), Service("install", 2.0, 80.0)]
  for t in things:
    puts t.describe
  puts things.sum(_.price)
