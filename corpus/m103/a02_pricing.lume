# a02 — field-less structs as pricing strategies behind an interface: as a
# struct field, as a parameter, held in a typed `[Pricing]` list (which
# warns), compared; and a field-less marker struct in an enum's payload, in
# a set, as a map key, and printed inside other values.
# Meant to RUN.
# EXPECTED OUTPUT:
# tea: 750 (regular)
# beer: 1000 (happy hour)
# cups: 1080 (bulk)
# bulk: 900
# regular: 1000
# bulk: 900
# happy hour: 500
# true
# ["printer jam", "server down"]
# Ticket(title: "new mouse", priority: Normal)
# High(why: Urgent())
# {Urgent()}
# 1
# {Urgent(): 3}
# EXPECTED STDERR:
# warning: `plans` holds values of different types behind `Pricing`, so calls on its items go through a pointer
#   --> corpus/m103/a02_pricing.lume:82:3
#    |
# 82 |   plans: [Pricing] = [Regular(), BulkDeal(), HappyHour()]
#    |   ^
#   help: fine for most code; use a single concrete type or an enum if this is a hot loop

interface Pricing:
  def price(cents: Int, qty: Int) -> Int
  def label -> Str

struct Regular:
  def price(cents: Int, qty: Int) -> Int = cents * qty
  def label -> Str = "regular"

struct BulkDeal:
  def price(cents: Int, qty: Int) -> Int:
    if qty >= 10:
      cents * qty * 9 / 10
    else:
      cents * qty
  def label -> Str = "bulk"

struct HappyHour:
  def price(cents: Int, qty: Int) -> Int = cents * qty / 2
  def label -> Str = "happy hour"

struct Line:
  sku: Str
  qty: Int
  cents: Int
  pricing: Pricing

  def cost -> Int = pricing.price(cents, qty)

struct Urgent

enum Priority:
  Normal
  High(why: Urgent)

struct Ticket:
  title: Str
  priority: Priority

def order_lines -> [Line] = [
  Line("tea", 3, 250, Regular()),
  Line("cups", 12, 100, BulkDeal()),
  Line("beer", 4, 500, HappyHour()),
]

def quote(p: Pricing, cents: Int, qty: Int) -> Str = "#{p.label}: #{p.price(cents, qty)}"

def main:
  for l in order_lines()
    .sort_by { |l| l.cost }:
    puts "#{l.sku}: #{l.cost} (#{l.pricing.label})"

  puts quote(BulkDeal(), 100, 9)

  plans: [Pricing] = [Regular(), BulkDeal(), HappyHour()]
  for p in plans:
    puts quote(p, 100, 10)
  puts Regular() == Regular()

  tickets = [
    Ticket("printer jam", High(Urgent())),
    Ticket("new mouse", Normal),
    Ticket("server down", High(Urgent())),
  ]
  urgent = tickets
    .filter { |t| t.priority == High(Urgent()) }
    .map(_.title)
    .to_list
  puts urgent
  puts tickets.at(1)
  puts tickets.at(0).priority
  flags = {Urgent(), Urgent()}
  puts flags
  puts flags.len
  seen = {Urgent(): tickets.len}
  puts seen
