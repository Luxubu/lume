# a06 — a task that adds up shelves by position walks one past the end
# with `.at`. Nothing is said until the task is awaited; then the program
# stops, naming the line inside the `spawn:` body.
# Meant to STOP.
# EXPECTED OUTPUT:
# [6, 10, 4]
# started
# EXPECTED STDERR:
# error: no item at 3 — the list has 3
#   --> corpus/m103/a06_shelf_task.lume:23
#    |
# 23 |       total += shelves.at(i)
# EXPECTED EXIT: 101

async def main:
  shelves = [3, 5, 2]
  puts shelves
    .map { |n| n * 2 }
    .to_list
  t = spawn:
    var total = 0
    for i in 0..shelves.len:
      total += shelves.at(i)
    total
  puts "started"
  puts await t
  puts "never printed"
