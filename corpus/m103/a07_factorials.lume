# a07 — a generator of factorials, walked by a `for` whose header is a
# chain over two lines. 21! does not fit in an `Int`, so the program stops
# inside the generator, on the multiplication, after printing 18! to 20!.
# Meant to STOP.
# EXPECTED OUTPUT:
# [1, 2, 6, 24, 120]
# 18! = 6402373705728000
# 19! = 121645100408832000
# 20! = 2432902008176640000
# EXPECTED STDERR:
# error: Int overflow in `*`
#   --> corpus/m103/a07_factorials.lume:23
#    |
# 23 |     f = f * n
# EXPECTED EXIT: 101

def factorials -> Iterator[Int]:
  var f = 1
  var n = 1
  while true:
    yield f
    n += 1
    f = f * n

def main:
  puts factorials().take(5).to_list
  for i, f in factorials()
    .enumerate
    .skip(17):
    puts "#{i + 1}! = #{f}"
