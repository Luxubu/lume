# a09 — a method whose chain forgot the value it starts from: the body's
# first line begins with `.`, so there is no line above it in the block to
# continue, and `lume check` refuses it at the dot.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: a line starting with `.` continues the line above, and this one begins a block
#   --> corpus/m103/a09_chain_first_line.lume:17:5
#    |
# 17 |     .map(_.capitalize)
#    |     ^
#   help: put the value the chain starts from first: `xs` on this line, and `.map ...` under it

struct Basket:
  fruit: [Str]

  def summary -> Str:
    .map(_.capitalize)
    .join(", ")

def main:
  b = Basket(fruit: ["fig", "pear"])
  puts b.summary
