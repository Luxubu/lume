# b15: `next` may name a field, and is read as `s.next`, but as a binding in
# `main` it is a keyword, and the message calls it one.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `next` is one of Lume's own words, so it cannot be a name
#   --> corpus/m103/b15_keyword_name.lume:17:3
#    |
# 17 |   next = s.next + 1
#    |   ^
#   help: pick another name, such as `next_count` or `my_next`

struct Step:
  next: Int

def main:
  s = Step(next: 2)
  next = s.next + 1
  puts next
