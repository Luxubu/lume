# a02_password_rules.lume — reviewer A, round nine
# Probes: blocks kept in tuples inside a list, `[(Str, (Str) -> Bool)]`, held
# in a struct field; functions of a type (`def self.min_len`) that hand back
# a block; a `var self` method that keeps the block it is given (by pushing
# it); a trailing `{ }` block on a method call with another argument; a
# two-name block taking the (name, block) tuples apart and calling the block
# half; a lone tuple holding a block, called as `pick.1(7)` and printed.
# Meant to RUN.
# EXPECTED OUTPUT:
# rules: ["at least 8", "has a digit", "no spaces", "mentions lume"]
# hunter2: at least 8; mentions lume
# correct horse: has a digit; no spaces; mentions lume
# lume4ever: ok
# x: at least 8; has a digit; mentions lume
# 1 of 4 passed
# square: 49
# ("square", <block>)

struct Rules:
  checks: [(Str, (Str) -> Bool)]

  def self.empty -> Rules = Rules(checks: [])
  def self.min_len(n: Int) -> (Str) -> Bool = { |s| s.len >= n }
  def self.has(piece: Str) -> (Str) -> Bool = { |s| s.contains?(piece) }

  def add(var self, label: Str, check: (Str) -> Bool):
    checks.push((label, check))

  def names -> [Str] = checks.map { |label, check| label }.to_list

  def failures(s: Str) -> [Str]:
    checks.filter { |label, check| not check(s) }.map { |label, check| label }.to_list

def main:
  var pw = Rules.empty
  pw.add("at least 8", Rules.min_len(8))
  pw.add("has a digit") { |s| s.chars.any? { |c| c.digit? } }
  pw.add("no spaces") { |s| not s.contains?(" ") }
  pw.add("mentions lume", Rules.has("lume"))
  puts "rules: #{pw.names}"

  var passed = 0
  candidates = ["hunter2", "correct horse", "lume4ever", "x"]
  for pwd in candidates:
    bad = pw.failures(pwd)
    if bad.empty?:
      passed += 1
      puts "#{pwd}: ok"
    else:
      puts "#{pwd}: #{bad.join("; ")}"
  puts "#{passed} of #{candidates.len} passed"

  pick: (Str, (Int) -> Int) = ("square", { |n| n * n })
  puts "#{pick.0}: #{pick.1(7)}"
  puts pick
