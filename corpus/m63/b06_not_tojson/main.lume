# b06 — a struct with no `to_json` passed where the json package's
# `ToJson` is needed.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: `Plain` is used as a `ToJson` here, but it has no `to_json` method
#   --> corpus/m63/b06_not_tojson/main.lume:22:13
#    |
# 22 |   puts emit(Plain(n: 1))
#    |             ^
#   help: `ToJson` needs: def to_json -> Json. Add it to `Plain`, or `extend Plain with ToJson:`

import json
import json.Json
import json.ToJson

struct Plain:
  n: Int

def emit(x: ToJson) -> Str = json.show(x.to_json)

def main:
  puts emit(Plain(n: 1))
