# c02_shop — a small store: orders with nested items and dates are decoded
# by a library package of its own (../c02_orders, which depends on json);
# invalid ones are reported by index and field, and the rest totalled by month.
# Probes: a program over two packages that both use json, `def self.from_json`
# called through an imported type, map_error at two levels, a date error from
# Time.parse inside a decode, group_by on a month key, Time.format with %a %b
# %B, and writing with json.show and json.pretty through ToJson.
# Meant to RUN.
# EXPECTED OUTPUT:
# Corner Shop: 10 orders, 4 accepted
# refused:
#   order 4: `placed`: `2024-13-02` does not match `%Y-%m-%d`: month 13 is not 1 to 12
#   order 5: item 1: `qty` is a string, not a whole number
#   order 6: item 2: `sku` is missing
#   order 7: order A7 has no items
#   order 9: `id` is a number, not a string
#   order 10: `items` is an object, not an array
# accepted:
#   A1  Tue 30 Jan 2024  15.25
#   A2  Wed 31 Jan 2024   3.50
#   A3  Thu 29 Feb 2024  38.00
#   A8  Sun 31 Mar 2024  45.00
# total: 101.75
# most sold: tea (7)
# by month:
#   January 2024: 2 orders, 18.75
#   February 2024: 1 order, 38.00
#   March 2024: 1 order, 45.00
# {"id":"A2","placed":"2024-01-31","items":[{"sku":"tea","qty":1,"cents":350}],"total":350}
# [
#   {
#     "month": "2024-01",
#     "orders": 2,
#     "cents": 1875
#   },
#   {
#     "month": "2024-02",
#     "orders": 1,
#     "cents": 3800
#   },
#   {
#     "month": "2024-03",
#     "orders": 1,
#     "cents": 4500
#   }
# ]

import json
import json.Json
import c02_orders
import c02_orders.Order

DOC = """
  {\"store\": \"Corner Shop\", \"orders\": [
    {\"id\": \"A1\", \"placed\": \"2024-01-30\", \"items\": [{\"sku\": \"tea\", \"qty\": 2, \"price\": 3.5}, {\"sku\": \"mug\", \"qty\": 1, \"price\": 8.25}]},
    {\"id\": \"A2\", \"placed\": \"2024-01-31\", \"items\": [{\"sku\": \"tea\", \"qty\": 1, \"price\": 3.5}]},
    {\"id\": \"A3\", \"placed\": \"2024-02-29\", \"items\": [{\"sku\": \"pot\", \"qty\": 1, \"price\": 24.0}, {\"sku\": \"tea\", \"qty\": 4, \"price\": 3.5}]},
    {\"id\": \"A4\", \"placed\": \"2024-13-02\", \"items\": [{\"sku\": \"tea\", \"qty\": 1, \"price\": 3.5}]},
    {\"id\": \"A5\", \"placed\": \"2024-03-01\", \"items\": [{\"sku\": \"mug\", \"qty\": \"two\", \"price\": 8.25}]},
    {\"id\": \"A6\", \"placed\": \"2024-03-02\", \"items\": [{\"sku\": \"tea\", \"qty\": 3, \"price\": 3.5}, {\"qty\": 1, \"price\": 1.0}]},
    {\"id\": \"A7\", \"placed\": \"2024-03-15\", \"items\": []},
    {\"id\": \"A8\", \"placed\": \"2024-03-31\", \"items\": [{\"sku\": \"pot\", \"qty\": 2, \"price\": 22.5}]},
    {\"id\": 9, \"placed\": \"2024-03-31\", \"items\": []},
    {\"id\": \"A10\", \"placed\": \"2024-03-31\", \"items\": {\"sku\": \"tea\"}}
  ]}
  """

struct MonthTotal:
  month: Str
  orders: Int
  cents: Int

  def to_json -> Json = json.obj([("month", month.to_json), ("orders", orders.to_json), ("cents", cents.to_json)])

def main:
  doc = match json.parse(DOC):
    Ok(d) -> d
    Error(e) ->
      warn "not JSON: #{e.message}"
      Env.exit(1)
  raw = match doc.need_items("orders"):
    Ok(xs) -> xs
    Error(e) ->
      warn e.message
      Env.exit(1)

  var good: [Order] = []
  var bad: [Str] = []
  for (i, o) in raw.enumerate:
    match Order.from_json(o):
      Ok(order) -> good.push(order)
      Error(e) -> bad.push("order #{i + 1}: #{e.message}")

  store = doc.need_str("store").or("a shop")
  puts "#{store}: #{raw.len} orders, #{good.len} accepted"
  puts "refused:"
  for b in bad:
    puts "  #{b}"
  puts "accepted:"
  for o in good:
    day = Time.format(o.placed, "%a %d %b %Y")
    puts "  #{o.id.pad_right(3)} #{day} #{c02_orders.money(o.total).pad(6)}"
  all_cents = good.map { |o| o.total }.sum
  puts "total: #{c02_orders.money(all_cents)}"

  var sold: {Str: Int} = {}
  for o in good:
    for it in o.items:
      sold[it.sku] = sold[it.sku].or(0) + it.qty
  match sold.max_by { |sku, n| n }:
    Some((sku, n)) -> puts "most sold: #{sku} (#{n})"
    None -> ()

  puts "by month:"
  by_month = good.group_by { |o| o.month }
  var months: [MonthTotal] = []
  for m, os in by_month:
    cents = os.map { |o| o.total }.sum
    plural = if os.len == 1: "" else: "s"
    label = Time.format(os.at(0).placed, "%B %Y")
    puts "  #{label}: #{os.len} order#{plural}, #{c02_orders.money(cents)}"
    months.push(MonthTotal(month: m, orders: os.len, cents: cents))

  puts json.show(good.at(1).to_json)
  puts json.pretty(months.to_json)
