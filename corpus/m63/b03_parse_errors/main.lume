# b03 — `json.parse` on text that is not JSON, and the exact error with its
# position: trailing commas, a bad escape, lone surrogates (high and low),
# a high surrogate followed by a plain `\u`, an unterminated string, empty
# text, a bare `-`, `1e`, a cut-off word, a missing `,` or `:`, trailing
# characters, a leading zero, a good surrogate pair and a short `\u`.
# Meant to RUN.
# EXPECTED OUTPUT:
# [[1, 2,]] unexpected character `]` at position 6
# [{"a": 1,}] expected `"`, found `}` at position 8
# ["a\x"] bad escape `\x` at position 4
# ["\ud800"] lone surrogate at position 7
# ["\udc00"] bad code point 56320
# ["\ud800\u0041"] ok "⑁"
# ["abc] unterminated string at position 4
# [] unexpected end of input at position 0
# [  ] unexpected end of input at position 2
# [-] bad number `-` at position 1
# [1e] bad number `1e` at position 2
# [tru] expected `true` at position 3
# [[1 2]] expected `,` or `]` at position 3
# [{"a" 1}] expected `:`, found `1` at position 5
# [1 2] trailing characters at position 2
# [01] ok 1
# ["\ud83d\ude00"] ok "😀"
# ["\u12"] short \u escape at position 3

import json

def main:
  texts = ["[1, 2,]", "{\"a\": 1,}", "\"a\\x\"", "\"\\ud800\"", "\"\\udc00\"", "\"\\ud800\\u0041\"", "\"abc", "", "  ", "-", "1e", "tru", "[1 2]", "{\"a\" 1}", "1 2", "01", "\"\\ud83d\\ude00\"", "\"\\u12\""]
  for t in texts:
    match json.parse(t):
      Ok(j) -> puts "[#{t}] ok #{json.show(j)}"
      Error(e) -> puts "[#{t}] #{e.message}"
