# b08 — `get` gives a `Json?`, so `.int` straight after it does not work:
# the most natural slip with the typed reads.
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: this value is a `Json?` — it may be absent, so `.int` cannot be called on it directly
#   --> corpus/m63/b08_get_then_int/main.lume:16:22
#    |
# 16 |   puts doc.get("age").int
#    |                      ^
#   help: unwrap it first: `match` on `Some(x)`/`None`, or `.or(default).int`

import json

def main -> () or Error:
  doc = json.parse("{\"age\": 36}")?
  puts doc.get("age").int
