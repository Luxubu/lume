# b11 — `Time.date` on 29 February in leap and non-leap years, 1900, 2000
# and 2100; days past the end of a month; times before 1970 formatted and
# taken apart; `Time.weekday` on known dates (the Moon landing, 1 January
# 2000, and the days either side of 1970).
# Meant to RUN.
# EXPECTED OUTPUT:
# 2024/2/29: 2024-02-29 Thu, day 60
# 2023/2/29: error: February 2023 has days 1 to 28, not 29
# 1900/2/29: error: February 1900 has days 1 to 28, not 29
# 2000/2/29: 2000-02-29 Tue, day 60
# 2100/2/29: error: February 2100 has days 1 to 28, not 29
# 2024/2/30: error: February 2024 has days 1 to 29, not 30
# 2023/4/31: error: April 2023 has days 1 to 30, not 31
# 1900/3/1: 1900-03-01 Thu, day 60
# 2024/12/31: 2024-12-31 Tue, day 366
# -1: 1969-12-31 23:59:59 Wednesday, weekday 3, day 365
# -86400: 1969-12-31 00:00:00 Wednesday, weekday 3, day 365
# -86401: 1969-12-30 23:59:59 Tuesday, weekday 2, day 364
# -2208988800: 1900-01-01 00:00:00 Monday, weekday 1, day 1
# 1969 12 31 23 59 59
# -14256000 Sunday 20 July 1969 weekday 7
# 6

def show(r: Int or Error) -> Str:
  match r:
    Ok(t) -> "#{Time.format(t, "%Y-%m-%d %a")}, day #{Time.day_of_year(t)}"
    Error(e) -> "error: #{e.message}"

def main:
  for (y, m, d) in [(2024, 2, 29), (2023, 2, 29), (1900, 2, 29), (2000, 2, 29), (2100, 2, 29), (2024, 2, 30), (2023, 4, 31), (1900, 3, 1), (2024, 12, 31)]:
    puts "#{y}/#{m}/#{d}: #{show(Time.date(y, m, d))}"
  for t in [-1, -86400, -86401, -2208988800]:
    puts "#{t}: #{Time.format(t, "%Y-%m-%d %H:%M:%S %A")}, weekday #{Time.weekday(t)}, day #{Time.day_of_year(t)}"
  puts "#{Time.year(-1)} #{Time.month(-1)} #{Time.day(-1)} #{Time.hour(-1)} #{Time.minute(-1)} #{Time.second(-1)}"
  moon = Time.date(1969, 7, 20).or(0)
  puts "#{moon} #{Time.format(moon, "%A %d %B %Y")} weekday #{Time.weekday(moon)}"
  puts Time.weekday(Time.date(2000, 1, 1).or(0))
