# b05 — `extend Str with json.ToJson` written in a package of your own: the
# orphan rule (`Str` is built in, `ToJson` is the json package's, and the
# json package already extends `Str` with it).
# Meant to FAIL.
# EXPECTED OUTPUT:
# error: package `b05_orphan` cannot extend `Str` with `json.ToJson`: neither is its own
#   --> corpus/m63/b05_orphan/main.lume:16:1
#    |
# 16 | extend Str with json.ToJson:
#    | ^
#   help: as in Rust, an `extend` goes in the package that defines the interface or the type; `json.ToJson` is from `json` and `Str` is built in. Wrap the type in a struct of your own and extend that

import json
import json.Json

extend Str with json.ToJson:
  def to_json -> Json = Json.Null

def main:
  puts json.show("hi".to_json)
