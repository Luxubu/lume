# a06 — a small invoice: lines in whole cents, a total, and three payments
# due 30, 60 and 90 days after the issue date (`Time.date` plus days of
# 86400 seconds). A due date on a Saturday or Sunday moves to the Monday,
# decided with `Time.weekday`; weekday and month names come from
# `Time.format`. Days until each payment are counted from a fixed "today".
# Meant to RUN.
# EXPECTED OUTPUT:
# INVOICE 2024-017
# issued Monday 29 January 2024, as of Friday 01 March 2024
#
# Consulting hours   12 x    85.00 =  1020.00
# Travel              1 x   234.50 =   234.50
# License             2 x    49.99 =    99.98
#                                    --------
# total                               1354.48
#
# payment 1: 451.49 due Wed 28 Feb 2024, 2 days overdue
# payment 2: 451.49 due Fri 29 Mar 2024, in 28 days
# payment 3: 451.50 due Mon 29 Apr 2024 (Sun 28 Apr is a weekend), in 59 days

struct Line:
  what: Str
  qty: Int
  cents: Int

  def total -> Int = qty * cents

DAY = 86400

def two(n: Int) -> Str = if n < 10: "0#{n}" else: "#{n}"

def money(cents: Int) -> Str = "#{cents / 100}.#{two(cents % 100)}"

# a due date on a weekend moves to the Monday after
def on_workday(t: Int) -> Int:
  match Time.weekday(t):
    6 -> t + 2 * DAY
    7 -> t + DAY
    _ -> t

def main -> () or Error:
  issued = Time.date(2024, 1, 29)?
  today = Time.date(2024, 3, 1)?
  lines = [Line("Consulting hours", 12, 8500), Line("Travel", 1, 23450), Line("License", 2, 4999)]

  puts "INVOICE 2024-017"
  puts "issued #{Time.format(issued, "%A %d %B %Y")}, as of #{Time.format(today, "%A %d %B %Y")}"
  puts ""
  for l in lines:
    puts "#{l.what.pad_right(18)} #{l.qty.pad(2)} x #{money(l.cents).pad(8)} = #{money(l.total).pad(8)}"
  total = lines.map(_.total).sum
  puts " ".repeat(35) + "-".repeat(8)
  puts "total".pad_right(35) + money(total).pad(8)
  puts ""

  share = total / 3
  for i in 1..3:
    amount = if i == 3: total - share * 2 else: share
    due = issued + i * 30 * DAY
    pay_by = on_workday(due)
    moved = if pay_by != due: " (#{Time.format(due, "%a %d %b")} is a weekend)" else: ""
    days = (pay_by - today) / DAY
    status = if days < 0: "#{0 - days} days overdue" elif days == 0: "due today" else: "in #{days} days"
    puts "payment #{i}: #{money(amount)} due #{Time.format(pay_by, "%a %d %b %Y")}#{moved}, #{status}"
