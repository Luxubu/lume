# Character indexing and slicing, including multibyte text
def main:
  s = "héllo"
  puts s[0]
  puts s[1]
  puts s[4]
  puts s[5]
  puts s[-1]
  puts s[1..2]
  puts s[1...2]
  puts s[0..0]
  puts "[#{s[0...0]}]"
  puts "[#{s[3..1]}]"
  puts s[2..99]
  puts s[-3..1]
  puts "[#{s[10..20]}]"
  jp = "日本語テキスト"
  puts jp.len
  puts jp[1]
  puts jp[0..1]
  puts jp[3...jp.len]
  em = "a😀b🎉c"
  puts em.len
  puts em[1]
  puts em[3]
  puts em[1..3]
  puts em[em.len - 1]
  puts s[1..3][1..2]
  puts s[1..3][1..2][0]
  puts "<" + s[0..1] + ">"
  puts s[0..1] + jp[0..0]
  puts s[0].or("?") + em[1].or("?")
