# Blocks capturing sets; recursion over slices
def allowed(words: [Str], banned: {Str}) -> [Str]:
  words.reject { |w| banned.contains?(w) }.to_list

def max_rec(xs: [Int]) -> Int:
  if xs.len == 1: xs[0].or(0)
  else: xs[0].or(0).max(max_rec(xs[1..xs.len]))

def pal?(s: Str) -> Bool:
  if s.len <= 1: true
  elif s[0] != s[s.len - 1]: false
  else: pal?(s[1...s.len - 1])

def subsets(xs: [Int]) -> [[Int]]:
  if xs.empty?: [[]]
  else:
    rest = subsets(xs[1..xs.len])
    head = xs[0].or(0)
    var out: [[Int]] = []
    for r in rest:
      out.push(r)
    for r in rest:
      var withh = [head]
      for x in r:
        withh.push(x)
      out.push(withh)
    out

def main:
  banned = {"darn", "heck"}
  puts allowed(["oh", "darn", "it", "heck"], banned)
  limit = {1, 3, 5}
  puts((1..6).to_list.filter { |n| limit.contains?(n) })
  var hits: {Int} = {}
  [4, 5, 4, 6].each { |n| hits.add(n) }
  puts hits
  puts max_rec([3, 9, 2, 7])
  puts pal?("racecar")
  puts pal?("été")
  puts pal?("abca")
  puts subsets([1, 2, 3]).len
  puts subsets([1, 2]).map { |s| s.to_set }.to_list
