# test blocks with assert over sets and slices
def uniq_chars(s: Str) -> {Char} = s.chars.to_set

def middle(s: Str) -> Str:
  if s.len <= 2: ""
  else: s[1...s.len - 1]

def main:
  puts uniq_chars("banana")
  puts middle("[core]")

test "uniq chars of banana":
  assert uniq_chars("banana") == {"b", "a", "n"}
  assert uniq_chars("banana").len == 3

test "middle strips ends":
  assert middle("[x]") == "x"
  assert middle("ab") == ""
  assert middle("«ok»") == "ok"

test "set algebra":
  a = {1, 2, 3}
  assert a.diff({2}) == {1, 3}
  assert a.union({4}).len == 4
  assert not a.contains?(9)

test "this fails on purpose":
  assert uniq_chars("aab") == {"a"}
