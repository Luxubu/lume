# Sets and slices through |> pipes; match arms with | and guards
enum Token:
  Word(w: Str)
  Num(n: Int)
  Sym(s: Str)

def lex(part: Str) -> Token:
  if part.digit?: Num(part.to_int.or(0))
  elif part.alpha?: Word(part)
  else: Sym(part)

def weight(t: Token) -> Int:
  match t:
    Num(n) if n > 100 -> 3
    Num(_) | Sym(_) -> 1
    Word(w) if w.len > 3 -> 2
    Word(_) -> 0

def distinct_words(text: Str) -> {Str}:
  text.split.to_list.to_set

def main:
  text = "the cat saw 7 cats and 700 dogs + the cat"
  n = text |> distinct_words |> .len
  puts n
  text |> distinct_words |> .sort |> puts
  toks = text.split.map(lex).to_list
  puts toks.map(weight).sum
  kinds = toks.map { |t| weight(t) }.to_list.to_set
  puts kinds
  kinds.sort |> puts
  firsts = text.split.map { |w| w[0..0] }.to_list.to_set
  puts firsts.sort.join("")
  "abcdef"[1..3] |> .upcase |> puts
