# http — HTTP requests: the status, the headers and the body.
#
#   resp = http.get("https://example.com/api/items")?
#   if resp.ok?: puts resp.body
#   items = resp.json?                        # the body, parsed (the json package)
#   http.post_json(url, doc)?                 # a Json document as the body
#   http.send("PUT", url, [("X-Key", k)], body)?
#
#   req = http.request("GET", url).header("Accept", "text/plain").timeout(5000)
#   up = http.request("PUT", url).with_file("big.csv", "text/csv").send?
#   made = http.request("POST", url).send_parts(rows())?    # a generator's parts
#   resp = req.send?                          # the whole body, waited for
#   resp = await req.fetch?                   # the same, as other tasks go on
#   opened = req.open?                        # status and headers now ...
#   for line in opened.lines:                 # ... and the body as it arrives
#
#   http.request("GET", url).with_query([("q", "pie")])   # ?q=pie
#   http.request("POST", url).with_form([("name", "Ada")])
#   http.encode("a b")   http.form(pairs)   http.parse_form(text)?
#
# Only a request that could not be made is an `Error` (no connection, a bad
# URL, a timeout). A 404 or a 500 is a `Response` like any other, with
# `ok?` false, as Python's requests and Rust's reqwest have it. Requests
# time out after 30 seconds unless they say otherwise. It is built on the
# Rust crate ureq.

import rust.ureq
import rust.tiny_http
import json
import json.Json

pub struct Response:
  status: Int
  # names in lower case, in the order the server sent them
  headers: [(Str, Str)]
  body: Str

  # a 2xx status
  def ok? -> Bool = status >= 200 and status < 300

  # a header's value; the name in any case
  def header(name: Str) -> Str?:
    n = name.downcase
    headers.find { |k, _| k == n }.map { |kv| kv.1 }

  # the body, parsed as JSON
  def json -> Json or Error = json.parse(body).map_error { |e| Error("the body is not JSON: #{e.message}") }

# A request to be made, built a step at a time; each step gives a new one.
pub struct Request:
  method: Str
  url: Str
  headers: [(Str, Str)]
  body: Str
  # how long to wait for an answer, in milliseconds
  timeout_ms: Int
  # a file to send as the body, read as it is sent; "" for none
  body_file: Str

  def header(name: Str, value: Str) -> Request = Request(method: method, url: url, headers: headers + [(name, value)], body: body, timeout_ms: timeout_ms, body_file: body_file)

  # a body, and what it is
  # (a body's `Content-Type` takes the place of one an earlier body gave)
  def with_body(text: Str, content_type: Str) -> Request = Request(method: method, url: url, headers: typed(content_type), body: text, timeout_ms: timeout_ms, body_file: "")

  # a file as the body, read as it is sent rather than held whole
  def with_file(path: Str, content_type: Str) -> Request = Request(method: method, url: url, headers: typed(content_type), body: "", timeout_ms: timeout_ms, body_file: path)

  # the headers, with `Content-Type` said once, as `content_type`
  def typed(content_type: Str) -> [(Str, Str)] = headers.reject { |h| h.0.downcase == "content-type" }.to_list + [("Content-Type", content_type)]

  # a form as the body: `a=1&b=two+words`, as a browser sends one
  def with_form(pairs: [(Str, Str)]) -> Request = with_body(form(pairs), "application/x-www-form-urlencoded")

  # a query added to the URL, after a `?` or the query it has
  def with_query(pairs: [(Str, Str)]) -> Request:
    return Request(method: method, url: url, headers: headers, body: body, timeout_ms: timeout_ms, body_file: body_file) if pairs.empty?
    joined = if url.contains?("?"): "#{url}&#{form(pairs)}" else: "#{url}?#{form(pairs)}"
    Request(method: method, url: joined, headers: headers, body: body, timeout_ms: timeout_ms, body_file: body_file)

  def timeout(ms: Int) -> Request = Request(method: method, url: url, headers: headers, body: body, timeout_ms: ms, body_file: body_file)

  # Makes it and waits for the whole answer.
  def send -> Response or Error:
    opened = open()?
    id = opened.body_id
    u = url
    text: Str or Error = rust:
      {
        use std::io::Read;
        let mut r = lume_parked().lock().unwrap().remove(&id);
        let mut b = Vec::new();
        let read = match r.as_mut() { Some(r) => r.read_to_end(&mut b).map(|_| ()), None => Ok(()) };
        match read {
          Ok(()) => Ok(String::from_utf8_lossy(&b).into_owned()),
          Err(e) => Err(Error { message: format!("reading the body from {}: {}", u, e) }),
        }
      }
    Response(status: opened.status, headers: opened.headers, body: text?)

  # The same as `send`, waited for in async code: other tasks go on.
  async def fetch -> Response or Error:
    req = Request(method: method, url: url, headers: headers, body: body, timeout_ms: timeout_ms, body_file: body_file)
    t = spawn: req.send
    await t

  # Makes it with a body of `parts`, each sent as the sequence makes it —
  # in chunks, as HTTP/1.1 sends a body whose length is not known — and
  # waits for the whole answer. `with_body` and `with_file` are set aside.
  def send_parts(parts: Iterator[Str]) -> Response or Error:
    m = method
    u = url
    hs = headers
    ms = timeout_ms
    raw: (Int, [(Str, Str)], Str) or Error = rust:
      {
        // the parts, read as bytes as ureq asks for them
        struct Parts<I: Iterator<Item = String>> { it: I, cur: Vec<u8>, at: usize }
        impl<I: Iterator<Item = String>> std::io::Read for Parts<I> {
            fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
                while self.at >= self.cur.len() {
                    match self.it.next() {
                        Some(p) => { self.cur = p.into_bytes(); self.at = 0; }
                        None => return Ok(0),
                    }
                }
                let n = buf.len().min(self.cur.len() - self.at);
                buf[..n].copy_from_slice(&self.cur[self.at..self.at + n]);
                self.at += n;
                Ok(n)
            }
        }
        let mut req = ureq::request(&m, &u).timeout(std::time::Duration::from_millis(ms.max(0) as u64));
        for (k, v) in hs.iter() {
            req = req.set(k, v);
        }
        match req.set("Transfer-Encoding", "chunked").send(Parts { it: parts, cur: Vec::new(), at: 0 }) {
            Ok(r) | Err(ureq::Error::Status(_, r)) => {
                let status = r.status() as i64;
                let names: Vec<(String, String)> = r.headers_names().iter().filter_map(|n| r.header(n).map(|v| (n.to_lowercase(), v.to_string()))).collect();
                match r.into_string() {
                    Ok(text) => Ok((status, names, text)),
                    Err(e) => Err(Error { message: format!("reading the body from {}: {}", u, e) }),
                }
            }
            Err(e) => Err(Error { message: format!("{} {}: {}", m, u, e) }),
        }
      }
    (status, got, text) = raw?
    Response(status: status, headers: got, body: text)

  # Makes it and gives the status and headers once they arrive; the body
  # comes after, as it arrives, through `lines` or `chunks`.
  def open -> Opened or Error:
    # the Rust below reads these by name
    m = method
    u = url
    hs = headers
    b = body
    f = body_file
    ms = timeout_ms
    raw: (Int, [(Str, Str)], Int) or Error = rust:
      {
        let mut req = ureq::request(&m, &u).timeout(std::time::Duration::from_millis(ms.max(0) as u64));
        for (k, v) in hs.iter() {
            req = req.set(k, v);
        }
        let got = if !f.is_empty() {
            // the file goes as it is read, with its length said first
            match std::fs::File::open(&f) {
                Ok(file) => {
                    let len = file.metadata().map(|md| md.len()).unwrap_or(0);
                    req.set("Content-Length", &len.to_string()).send(file)
                }
                Err(e) => return Err(Error { message: format!("{} {}: cannot read `{}`: {}", m, u, f, lume_io(&e)) }),
            }
        } else if b.is_empty() { req.call() } else { req.send_string(&b) };
        match got {
            Ok(r) | Err(ureq::Error::Status(_, r)) => {
                let status = r.status() as i64;
                let names: Vec<(String, String)> = r.headers_names().iter().filter_map(|n| r.header(n).map(|v| (n.to_lowercase(), v.to_string()))).collect();
                Ok((status, names, lume_park(::std::boxed::Box::new(r.into_reader()))))
            }
            Err(e) => {
                // a timeout says so in every system's words: Windows' own
                // ("did not properly respond after a period of time") does not
                let mut timed_out = false;
                let mut cause: Option<&(dyn std::error::Error + 'static)> = std::error::Error::source(&e);
                while let Some(c) = cause {
                    if let Some(io) = c.downcast_ref::<std::io::Error>() {
                        timed_out |= matches!(io.kind(), std::io::ErrorKind::TimedOut | std::io::ErrorKind::WouldBlock);
                    }
                    cause = c.source();
                }
                let text = e.to_string();
                let text = if timed_out && !text.contains("timed out") { format!("{} (timed out)", text) } else { text };
                Err(Error { message: format!("{} {}: {}", m, u, text) })
            }
        }
      }
    (status, got, id) = raw?
    Opened(status: status, headers: got, body_id: id)

# A response whose body has not been read yet.
pub struct Opened:
  status: Int
  headers: [(Str, Str)]
  # the body, set aside until it is walked; it can be walked once
  body_id: Int

  def ok? -> Bool = status >= 200 and status < 300

  def header(name: Str) -> Str?:
    n = name.downcase
    headers.find { |k, _| k == n }.map { |kv| kv.1 }

  # the body a line at a time, without line endings, as it arrives
  def lines -> async Iterator[Str]:
    id = body_id
    s: async Iterator[Str] = rust:
      lume_parked_lines(id)
    s

  # the body in the pieces it arrives in
  def chunks -> async Iterator[Str]:
    id = body_id
    s: async Iterator[Str] = rust:
      lume_parked_chunks(id)
    s

# A request to make: `http.request("GET", url)`, then `.header`, `.with_body`
# and `.timeout` as needed.
pub def request(method: Str, url: Str) -> Request = Request(method: method, url: url, headers: [], body: "", timeout_ms: 30000, body_file: "")

pub def get(url: Str) -> Response or Error = request("GET", url).send

pub def delete(url: Str) -> Response or Error = request("DELETE", url).send

# a body, and what it is: `http.post(url, "a=1", "application/x-www-form-urlencoded")`
pub def post(url: Str, body: Str, content_type: Str) -> Response or Error = request("POST", url).with_body(body, content_type).send

pub def put(url: Str, body: Str, content_type: Str) -> Response or Error = request("PUT", url).with_body(body, content_type).send

# a JSON document as the body
pub def post_json(url: Str, doc: Json) -> Response or Error = post(url, json.show(doc), "application/json")

# Any method, headers of your own, and a body ("" for none).
pub def send(method: Str, url: Str, headers: [(Str, Str)], body: Str) -> Response or Error:
  Request(method: method, url: url, headers: headers, body: body, timeout_ms: 30000, body_file: "").send

# ---- Encoding: URLs and forms ---------------------------------------------

# A piece of a URL — a path segment, a query value — with every byte but
# letters, digits and `-._~` written as `%XX`: `http.encode("two words")` is
# `two%20words`.
pub def encode(text: Str) -> Str = escape(text, false)

# The other way: `%XX` back to its byte. An `Error` for a `%` not followed by
# two hex digits, or bytes that are not UTF-8 text.
pub def decode(text: Str) -> Str or Error = unescape(text, false)

# Names and values as a form, or a query, sends them: `a=1&b=two+words`,
# each encoded, with a space as `+`.
pub def form(pairs: [(Str, Str)]) -> Str = pairs.map { |k, v| "#{escape(k, true)}=#{escape(v, true)}" }.join("&")

# A form or a query back into its names and values, in order, a `+` read as
# a space. A name with no `=` has the value `""`; `""` gives none.
pub def parse_form(text: Str) -> [(Str, Str)] or Error:
  var out: [(Str, Str)] = []
  for piece in text.split("&"):
    next if piece.empty?
    (k, v) = match piece.index_of("="):
      Some(i) -> (piece.slice(0, i), piece.slice(i + 1, piece.len))
      None -> (piece, "")
    out.push((unescape(k, true)?, unescape(v, true)?))
  Ok(out)

def escape(text: Str, plus: Bool) -> Str:
  out: Str = rust:
    {
      let mut out = String::with_capacity(text.len());
      for b in text.bytes() {
        match b {
          b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'.' | b'_' | b'~' => out.push(b as char),
          b' ' if plus => out.push('+'),
          _ => out.push_str(&format!("%{:02X}", b)),
        }
      }
      out
    }
  out

def unescape(text: Str, plus: Bool) -> Str or Error:
  out: Str or Error = rust:
    {
      let src = text.as_bytes();
      let mut bytes = Vec::with_capacity(src.len());
      let mut i = 0;
      let mut bad: Option<String> = None;
      while i < src.len() {
        match src[i] {
          b'%' => {
            let hex = |c: u8| (c as char).to_digit(16);
            match (src.get(i + 1).and_then(|c| hex(*c)), src.get(i + 2).and_then(|c| hex(*c))) {
              (Some(a), Some(b)) => { bytes.push((a * 16 + b) as u8); i += 3; }
              _ => {
                let end = (i + 3).min(src.len());
                bad = Some(String::from_utf8_lossy(&src[i..end]).into_owned());
                break;
              }
            }
          }
          b'+' if plus => { bytes.push(b' '); i += 1; }
          c => { bytes.push(c); i += 1; }
        }
      }
      match bad {
        Some(b) => Err(Error { message: format!("`{}` in `{}` is not a byte written as `%` and two hex digits", b, text) }),
        None => String::from_utf8(bytes).map_err(|_| Error { message: format!("`{}` does not decode to UTF-8 text", text) }),
      }
    }
  out

# ---- Serving (a preview: its shape may change in a 1.x release) ----------
#
#   server = http.listen("127.0.0.1:8080")?
#   for req in server.requests:
#     req.respond(http.reply(200, "hello from #{req.path}"))?
#
# It is built on the Rust crate tiny_http.

# A server listening for requests, from `http.listen`.
pub struct Server:
  # the address it listens on, with the port it was given: `127.0.0.1:8080`
  address: Str
  port: Int
  # the server, set aside under a number; Lume's own
  server_id: Int

  # Waits for the next request, and gives it with its whole body read.
  # An `Error` once the server is closed.
  def accept -> Incoming or Error:
    id = server_id
    raw: (Str, Str, [(Str, Str)], Str, Int) or Error = rust:
      {
        use std::io::Read;
        let s = lume_held().lock().unwrap().get(&id).and_then(|b| b.downcast_ref::<std::sync::Arc<tiny_http::Server>>()).cloned();
        match s {
          None => Err(Error { message: String::from("the server is closed") }),
          Some(s) => match s.recv() {
            Ok(mut r) => {
              let method = r.method().to_string();
              let url = r.url().to_string();
              let names: Vec<(String, String)> = r.headers().iter().map(|h| (h.field.as_str().as_str().to_lowercase(), h.value.as_str().to_string())).collect();
              let mut b = Vec::new();
              match r.as_reader().read_to_end(&mut b) {
                Ok(_) => Ok((method, url, names, String::from_utf8_lossy(&b).into_owned(), lume_hold(r))),
                Err(e) => Err(Error { message: format!("reading the body of {} {}: {}", method, url, e) }),
              }
            }
            Err(e) => Err(Error { message: format!("the server stopped: {}", e) }),
          },
        }
      }
    (method, url, got, body, rid) = raw?
    (path, query) = match url.index_of("?"):
      Some(i) -> (url.slice(0, i), url.slice(i + 1, url.len))
      None -> (url, "")
    Incoming(method: method, path: path, query: query, headers: got, body: body, answer_id: rid)

  # Every request, as it comes, until the server is closed: for a `for`.
  def requests -> Iterator[Incoming]:
    while true:
      match accept():
        Ok(r) -> yield r
        Error(_) -> return

  # The same, waited for in async code: other tasks go on meanwhile.
  async def incoming -> Iterator[Incoming]:
    s = Server(address: address, port: port, server_id: server_id)
    while true:
      t = spawn: s.accept
      match await t:
        Ok(r) -> yield r
        Error(_) -> return

  # Stops listening; an `accept` waiting now gives an `Error`.
  def close -> ():
    id = server_id
    gone: () = rust:
      {
        let s = lume_held().lock().unwrap().remove(&id);
        if let Some(s) = s.and_then(|b| b.downcast::<std::sync::Arc<tiny_http::Server>>().ok()) {
          s.unblock();
        }
      }
    gone

# A request that came to a server: read it, then answer it once with `respond`.
pub struct Incoming:
  method: Str
  # the path, without its query: `/menu`
  path: Str
  # what follows `?` in the URL, as it was sent; "" for none
  query: Str
  # names in lower case, in the order the client sent them
  headers: [(Str, Str)]
  body: Str
  # the connection waiting for the answer; Lume's own
  answer_id: Int

  def header(name: Str) -> Str?:
    n = name.downcase
    headers.find { |k, _| k == n }.map { |kv| kv.1 }

  # the body, parsed as JSON
  def json -> Json or Error = json.parse(body).map_error { |e| Error("the body is not JSON: #{e.message}") }

  # the query's names and values, decoded: `?q=pie&n=2` gives
  # `[("q", "pie"), ("n", "2")]`
  def params -> [(Str, Str)] or Error = parse_form(query)

  # a form sent as the body, decoded the same way
  def form -> [(Str, Str)] or Error = parse_form(body)

  # Sends the answer. A request is answered once: a second time is an `Error`.
  def respond(r: Reply) -> () or Error:
    return Error("#{r.status} is not an HTTP status: one from 100 to 599") if r.status < 100 or r.status > 599
    id = answer_id
    status = r.status
    hs = r.headers
    text = r.body
    what = "#{method} #{path}"
    done: () or Error = rust:
      {
        let r = lume_held().lock().unwrap().remove(&id).and_then(|b| b.downcast::<tiny_http::Request>().ok());
        match r {
          None => Err(Error { message: format!("{} has been answered already", what) }),
          Some(r) => {
            let mut resp = tiny_http::Response::from_data(text.clone().into_bytes()).with_status_code(status as u16);
            for (k, v) in hs.iter() {
              if let Ok(h) = tiny_http::Header::from_bytes(k.as_bytes(), v.as_bytes()) {
                resp.add_header(h);
              }
            }
            (*r).respond(resp).map_err(|e| Error { message: format!("answering {}: {}", what, e) })
          }
        }
      }
    done

# An answer to an `Incoming`, built a step at a time as a `Request` is.
pub struct Reply:
  status: Int
  headers: [(Str, Str)]
  body: Str

  def header(name: Str, value: Str) -> Reply = Reply(status: status, headers: headers + [(name, value)], body: body)

  # a body, and what it is, in place of the one before
  def with_body(text: Str, content_type: Str) -> Reply = Reply(status: status, headers: headers.reject { |h| h.0.downcase == "content-type" }.to_list + [("Content-Type", content_type)], body: text)

# An answer of text: `http.reply(404, "not here")`.
pub def reply(status: Int, text: Str) -> Reply = Reply(status: status, headers: [("Content-Type", "text/plain; charset=utf-8")], body: text)

# An answer of a JSON document.
pub def reply_json(status: Int, doc: Json) -> Reply = reply(status, "").with_body(json.show(doc), "application/json")

# Listens at `address` — `"127.0.0.1:8080"`, or port 0 for one the system
# picks, which `port` then says.
pub def listen(address: Str) -> Server or Error:
  raw: (Int, Int) or Error = rust:
    {
      match tiny_http::Server::http(&*address) {
        Ok(s) => {
          let port = s.server_addr().to_ip().map(|a| a.port() as i64).unwrap_or(0);
          Ok((port, lume_hold(std::sync::Arc::new(s))))
        }
        Err(e) => Err(Error { message: format!("cannot listen on {}: {}", address, e) }),
      }
    }
  (port, id) = raw?
  # the host as it was given, before the last `:`, with the port it got
  parts = address.split(":").to_list
  host = parts.take(parts.len - 1).join(":")
  Server(address: "#{host}:#{port}", port: port, server_id: id)

test "a request that cannot be made is an Error":
  r = get("not a url")
  assert r.error?

test "a response reads its headers in any case":
  r = Response(status: 404, headers: [("content-type", "text/plain")], body: "gone")
  assert not r.ok?
  assert r.header("Content-Type") == Some("text/plain")
  assert r.json.error?

test "a request is built a step at a time":
  r = request("POST", "http://example.com").header("X-A", "1").with_body("{}", "application/json").timeout(500)
  assert r.headers == [("X-A", "1"), ("Content-Type", "application/json")]
  assert r.body == "{}"
  assert r.timeout_ms == 500

test "a reply is built a step at a time":
  r = reply(404, "not here").header("X-A", "1")
  assert r.status == 404
  assert r.headers == [("Content-Type", "text/plain; charset=utf-8"), ("X-A", "1")]
  j = reply_json(200, json.Json.Bool(true))
  assert j.headers == [("Content-Type", "application/json")]
  assert j.body == "true"

test "an address that cannot be listened on is an Error":
  assert listen("not an address").error?

test "a piece of a URL is encoded, and decoded back":
  assert encode("two words & a café") == "two%20words%20%26%20a%20caf%C3%A9"
  assert decode("two%20words%20%26%20a%20caf%C3%A9")! == "two words & a café"
  assert decode("100%").error?
  assert decode("%FF").error?

test "a form is written, and read back":
  f = form([("q", "pie & tea"), ("n", "2")])
  assert f == "q=pie+%26+tea&n=2"
  assert parse_form(f)! == [("q", "pie & tea"), ("n", "2")]
  assert parse_form("")! == []
  assert parse_form("a&b=&&c=1")! == [("a", ""), ("b", ""), ("c", "1")]

test "a request gets a form, or a query":
  r = request("POST", "http://example.com/find").with_query([("page", "2")]).with_query([("q", "a b")]).with_form([("name", "Ada")])
  assert r.url == "http://example.com/find?page=2&q=a+b"
  assert r.body == "name=Ada"
  assert r.headers == [("Content-Type", "application/x-www-form-urlencoded")]
