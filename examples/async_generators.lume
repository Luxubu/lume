# An `async def` with `yield` is an async generator: its body may `await`,
# and its items arrive one at a time. It runs as a task that is never more
# than one item ahead of whoever walks it; `for` waits for each item, and
# letting go of it ends the body at its next `yield`. Rust has this as the
# `async-stream` crate's `stream!`.

async def fetch_score(name: Str) -> Int:
  # stands for a request: what comes back depends only on the name
  await Time.sleep(2)
  name.len * 10

# each item needs a wait of its own
async def scores(names: [Str]) -> Iterator[(Str, Int)]:
  for n in names:
    yield (n, await fetch_score(n))

# a method may be one: the task its body runs as walks a copy of the value
struct Station:
  name: Str
  every: Int

  async def readings(count: Int) -> Iterator[Int]:
    for i in 1..count:
      await Time.sleep(every)
      yield i * name.len

# never ends: whoever walks it decides when to stop
async def ticks(label: Str) -> Iterator[Str]:
  var n = 0
  while true:
    await Time.sleep(1)
    n += 1
    yield "#{label} #{n}"

async def main:
  for name, score in scores(["ann", "bob", "cy"]):
    puts "#{name}: #{score}"

  # moved along by hand, then walked; breaking out ends it
  var t = ticks("tick")
  puts t.next
  for x in t:
    puts x
    break if x == "tick 3"

  # all of its items at once
  puts scores(["dee"]).to_list

  # a task may walk one; the task takes it
  s = scores(["eve", "flo"])
  total = spawn:
    var sum = 0
    for _, v in s:
      sum += v
    sum
  puts await total

  # chains hand items on as they arrive, as Rust's `StreamExt` does; their
  # blocks copy in the names they use
  most = 30
  puts scores(["al", "bea", "cass", "dmitri"]).filter { |p| p.1 < most }.map { |p| p.0 }.to_list
  puts ticks("t").skip(2).take(2).to_list
  puts Station(name: "ab", every: 1).readings(5).take_while { |r| r < 8 }.enumerate.to_list
  for r in Station(name: "xyz", every: 1).readings(3).reject { |r| r == 6 }:
    puts r

  # the methods that wait for the items; `find` and `any?` stop at their answer
  puts ticks("w").find { |x| x.ends_with?("4") }
  puts scores(["ann", "bob"]).count { |p| p.1 > 20 }
  puts Station(name: "abc", every: 1).readings(3).fold(0) { |acc, r| acc + r }
  var heard: [Str] = []
  scores(["kim", "lu"]).each { |p| heard.push(p.0) }
  puts heard
