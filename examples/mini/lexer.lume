# lexer.lume — text to tokens. Every token carries the line it came from, so
# the parser and the evaluator can say where something went wrong.

pub enum Tok:
  Num(value: Float)
  Str(text: Str)
  Name(text: Str)
  Keyword(word: Str)
  Op(sym: Str)
  Newline
  End

  def describe -> Str:
    match self:
      Num(v)     -> "the number #{v}"
      Str(_)     -> "a string"
      Name(n)    -> "`#{n}`"
      Keyword(w) -> "`#{w}`"
      Op(s)      -> "`#{s}`"
      Newline    -> "the end of the line"
      End        -> "the end of the program"

pub struct Token:
  tok: Tok
  line: Int

KEYWORDS = {"let", "if", "else", "while", "fn", "return", "true", "false", "and", "or", "not", "print"}

# Two-character operators are tried before one-character ones.
OPERATORS = {"==", "!=", "<=", ">=", "+", "-", "*", "/", "%", "<", ">", "=", "(", ")", "{", "}", ",", ";"}
PAIRS = {"==", "!=", "<=", ">="}

pub def lex(src: Str) -> [Token] or Error:
  cs = src.chars
  var out: [Token] = []
  var i = 0
  var line = 1
  while i < cs.len:
    c = cs[i].or("\u{0}")
    if c == "\n":
      out.push(Token(Newline, line))
      line += 1
      i += 1
      next
    if c == " " or c == "\t" or c == "\r":
      i += 1
      next
    if c == "#":
      while i < cs.len and cs[i].or("\n") != "\n":
        i += 1
      next
    if c.digit?:
      start = i
      while i < cs.len and cs[i].or("x").digit?:
        i += 1
      if i < cs.len and cs[i].or("x") == "." and i + 1 < cs.len and cs[i + 1].or("x").digit?:
        i += 1
        while i < cs.len and cs[i].or("x").digit?:
          i += 1
      text = cs[start...i].join("")
      out.push(Token(Num(text.to_float?), line))
      next
    if c == "\"":
      i += 1
      var text = ""
      var closed = false
      while i < cs.len:
        ch = cs[i].or("\u{0}")
        i += 1
        if ch == "\"":
          closed = true
          break
        if ch == "\\":
          esc = cs[i].or("n")
          i += 1
          text += match esc:
            "n" -> "\n"
            "t" -> "\t"
            _   -> esc.to_s
          next
        text += ch
      if not closed:
        return Error("line #{line}: a string is not closed")
      out.push(Token(Str(text), line))
      next
    if c.alpha? or c == "_":
      start = i
      while i < cs.len and (cs[i].or("+").alnum? or cs[i].or("+") == "_"):
        i += 1
      word = cs[start...i].join("")
      out.push(Token(if KEYWORDS.contains?(word): Keyword(word) else: Name(word), line))
      next
    match two_char(cs, i):
      Some(op) ->
        out.push(Token(Op(op), line))
        i += 2
      None ->
        if not OPERATORS.contains?(c.to_s):
          return Error("line #{line}: `#{c}` does not mean anything here")
        out.push(Token(Op(c.to_s), line))
        i += 1
  out.push(Token(End, line))
  out

def two_char(cs: [Char], i: Int) -> Str?:
  if i + 1 >= cs.len:
    return None
  pair = cs[i...i + 2].join("")
  if PAIRS.contains?(pair): Some(pair) else: None

test "lexing":
  ts = lex("let x = 1 + 2")!
  assert ts.len == 7
  assert ts[0].map { |t| t.tok.describe } == Some("`let`")
  assert ts[6].map { |t| t.tok.describe } == Some("the end of the program")

test "strings and comments":
  ts = lex("print \"a\\nb\" # trailing")!
  assert ts.len == 3
  match ts[1].map { |t| t.tok }:
    Some(Str(text)) -> assert text == "a\nb"
    _               -> assert false

test "lexing errors":
  match lex("let x = \"oops"):
    Ok(_)    -> assert false
    Error(e) -> assert e.message == "line 1: a string is not closed"
  match lex("a $ b"):
    Ok(_)    -> assert false
    Error(e) -> assert e.message == "line 1: `$` does not mean anything here"
