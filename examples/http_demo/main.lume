# http_demo — the http package against a server: a JSON document, a page
# that is not there, a POST that is echoed back, a body read as it arrives,
# a request that times out, requests made from tasks, and a server that is
# not running. tests/http_local.sh starts a small server on this machine
# and runs it:
#
#   lume run -- http://127.0.0.1:8765

import http
import json

# lines made one at a time, as an upload is
def numbered(n: Int) -> Iterator[Str]:
  for i in 1..n:
    yield "part #{i}\n"

async def main -> () or Error:
  base = Env.args.first.or("http://127.0.0.1:8765")

  r = http.get("#{base}/hello.json")?
  puts "GET /hello.json: #{r.status}, #{r.header("content-type").or("no type")}"
  doc = r.json?
  puts "  ok is #{doc.path("ok").map(json.show).or("missing")}"

  gone = http.get("#{base}/nope")?
  puts "GET /nope: #{gone.status}, ok? #{gone.ok?}"

  sent = json.obj([("name", "lume".to_json), ("n", 3.to_json)])
  echo = http.post_json("#{base}/echo", sent)?
  back = echo.json?
  puts "POST /echo: #{echo.status}, sent back #{json.show(back.get("body").or(json.Json.Null))}"
  puts "  as #{back.get("type").map { |t| t.str.or("?") }.or("?")}"

  # the status and headers first, then the body a line at a time as the
  # server writes it
  opened = http.request("GET", "#{base}/lines").open?
  puts "GET /lines: #{opened.status}, #{opened.header("content-type").or("no type")}"
  for line in opened.lines:
    puts "  #{line}"
  pieces = http.request("GET", "#{base}/lines").open?.chunks.fold("") { |all, c| all + c }
  puts "  the same in pieces: #{pieces.lines.len} lines"

  # an answer slower than the request waits for is an Error
  match http.request("GET", "#{base}/slow").timeout(300).send:
    Ok(_) -> puts "GET /slow: answered within 300 ms?"
    Error(e) -> puts "GET /slow, 300 ms: an Error that says it timed out: #{e.message.contains?("timed out")}"

  # from tasks, waited for as other work goes on
  statuses = await ["hello.json", "nope", "hello.json"].map { |p| spawn: await http.request("GET", "#{base}/#{p}").fetch }.to_list
  puts "three at once: #{statuses.map { |r| r.map { |x| x.status }.or(0) }.to_list}"

  # a body sent as it is made: a file read as it goes, then a generator's parts
  path = "/tmp/lume-http-demo-upload.txt"
  File.write(path, (1..1000).map { |n| "line #{n}" }.join("\n") + "\n")?
  up = http.request("PUT", "#{base}/upload").with_file(path, "text/plain").send?
  puts "PUT a file: #{up.body}"
  File.remove(path)?
  made = http.request("PUT", "#{base}/upload").header("Content-Type", "text/plain").send_parts(numbered(500))?
  puts "PUT the parts: #{made.body}"
  match http.request("PUT", "#{base}/upload").with_file("/no/such/file", "text/plain").send:
    Ok(_) -> puts "sent a file that is not there?"
    Error(e) -> puts "a file that is not there: #{e.message}"

  # nothing listens on port 9: a request that cannot be made is an Error
  match http.get("http://127.0.0.1:9/"):
    Ok(_) -> puts "port 9 answered?"
    Error(_) -> puts "port 9: no connection, an Error"
  ()
