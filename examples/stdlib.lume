# The standard methods added in milestone 17, one line each.

def main:
  # Str
  puts "hello world".capitalize
  puts "hello".index_of("ll")
  puts "hello".index_of("zz")
  puts "123".digit?
  puts "12a".digit?
  puts "abc".alpha?
  puts "  ".space?
  puts "[#{"ab".pad_right(5)}]"
  puts "[#{"ab".pad(5)}]"
  # `split` with no separator splits on whitespace and drops the empties;
  # `split(sep)` keeps every piece, so it undoes a `join` exactly.
  puts "a  b   c".split.to_list
  puts "a:b:c".split(":").to_list
  puts "a:".split(":").to_list          # the trailing piece is a piece
  puts ":a".split(":").to_list
  puts "".split(":").to_list            # always at least one
  puts "a::b".split(":").to_list
  puts "a:b:".split(":").join(":")      # split then join gives it back
  # milestone 24: the pieces a library asked for
  puts "[#{"  hi  ".trim_left}]"
  puts "[#{"  hi  ".trim_right}]"
  puts 1234.5.decimals(2)
  puts 0.125.decimals(2)
  puts 7.decimals(1)
  puts [10, 20, 30].at(1)
  # numbers
  puts 3.max(7)
  puts 3.min(7)
  puts 15.clamp(0, 10)
  puts 2.pow(10)
  puts 2.5.pow(2.0)
  puts 4.even?
  puts 4.odd?
  puts 1.5.max(0.5)
  # lists
  xs = [3, 1, 3, 2, 1]
  puts xs.uniq
  puts xs.index_of(2)
  puts xs.index_of(9)
  puts xs.avg
  puts [1.0, 2.0].avg
  puts [[1, 2], [3]].flatten
  puts [1, 2, 3].zip(["a", "b", "c"])
  var ys = [1, 2, 3]
  ys.insert(1, 10)
  puts ys
  removed = ys.remove_at(0)
  puts removed
  puts ys
  puts((1..10).to_list.group_by { |n| n % 3 })
  words = ["apple", "bob", "avocado"]
  puts words.group_by { |w| w.slice(0, 1) }
  puts((1..6).to_list.partition { |n| n > 3 })
  parts = (1..6).to_list.partition { |n| n > 3 }
  puts parts.0
  puts [1, 2, 3].flat_map { |n| [n, n * 10] }
  puts words.flat_map { |w| w.chars.take(2).to_list }
  # maps
  m = {"a": 1, "b": 2, "c": 3}
  puts m.merge({"c": 30, "d": 4})
  puts m.filter { |k, v| v > 1 }
  puts m.reject { |k, v| k == "a" }
  puts m.map_values { |v| v * 100 }
  m.each { |k, v| puts "#{k}: #{v > 1}" }
  # option / result
  o = Some(4)
  puts o.map { |x| x * 2 }
  n: Int? = None
  puts n.map { |x| x * 2 }
  r = "42".to_int
  puts r.ok
  puts "x".to_int.ok
  puts r.map { |x| x + 1 }
  names = ["ann", "bo"]
  puts names.zip([1, 2]).map { |n, i| "#{n}#{i}" }.to_list
