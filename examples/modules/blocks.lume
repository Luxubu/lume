# blocks.lume — a function of an imported module where a block is wanted.
# `model.parse` is handed over, not called, the way a local function's
# name is: `lines.map(model.parse)`.

import users.model

def parse_all(xs: [Str], f: (Str) -> model.User or Error) -> [model.User or Error]:
  var out: [model.User or Error] = []
  for x in xs:
    out.push(f(x))
  out

def main:
  lines = ["Ana, ana@x.com, admin", "Bo, bo@x.com, wizard", "Cy, cy@x.com, guest"]
  parsed = lines.map(model.parse).to_list
  good = parsed.count { |r| r.ok? }
  puts "#{good} of #{parsed.len} parsed"
  for r in parsed:
    match r:
      Ok(u)    -> puts u.label
      Error(e) -> puts "skipped: #{e.message}"
  # the same function handed to a block parameter of our own
  again = parse_all(lines, model.parse)
  puts again.count { |r| r.error? }

  # a function of an imported type, called through the module
  puts model.User.guest("Eve").label
