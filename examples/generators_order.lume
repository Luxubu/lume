# Generators that are a loop around one `yield` run as plain Rust
# iterators, and do their work when, and in the order, the coroutine did:
# an item is made when it is asked for, the rest of a turn runs when the
# next is, and a generator whose set-up prints still prints only when
# first asked.

def count_up(from: Int, to: Int) -> Iterator[Int]:
  var n = from
  while n <= to:
    puts "making #{n}"
    n += 1
    yield n - 1

def loud(seed: Int) -> Iterator[Int]:
  puts "starting"
  var s = seed
  while true:
    s += 1
    yield s

def evens -> Iterator[Int]:
  var n = 0
  while true:
    n += 2
    if n > 6:
      puts "big"
    yield n

def first_part:
  g = count_up(1, 3)
  puts "made"
  for x in g:
    puts "got #{x}"
  h = loud(10)
  puts "made loud"
  puts h.take(2).to_list
  puts evens().take(4).to_list
  var e = count_up(5, 5)
  puts e.next
  puts e.next
  puts e.next

def naturals -> Iterator[Int]:
  var n = 0
  while true:
    yield n
    n += 1

def fib -> Iterator[Int]:
  var a = 0
  var b = 1
  while true:
    yield a
    t = a + b
    a = b
    b = t

def upto(limit: Int) -> Iterator[Int]:
  var n = 1
  while n <= limit:
    sq = n * n
    yield sq
    puts "after #{n}"
    n += 1

def main:
  first_part()
  puts naturals().take(4).to_list
  puts fib().take(8).to_list
  for x in upto(2):
    puts "got #{x}"
