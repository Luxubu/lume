# A generator keeps the block it is given and runs it later, so the names
# the block uses are copied in, and changing one inside is refused.

def keep(xs: [Int], ok: (Int) -> Bool) -> Iterator[Int]:
  for x in xs:
    yield x if ok(x)

def main:
  var seen = 0
  for x in keep([1, 2]) do |x|
    seen += 1
    x > 1
  :
    puts x
