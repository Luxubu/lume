# A chain too long for one line: each step on a line of its own, starting
# with `.`, continues the line above — in a binding, a method, a `for`
# header and an argument.

struct Order:
  table: Int
  dishes: [Str]

  def summary -> Str = dishes
    .map(_.capitalize)
    .join(", ")

def main:
  orders = [
    Order(table: 1, dishes: ["soup", "pie"]),
    Order(table: 2, dishes: ["stew"]),
    Order(table: 3, dishes: ["tea", "toast", "jam"]),
  ]
  busy = orders
    .filter { |o| o.dishes.len > 1 }
    .map { |o| o.table }
    .to_list
  puts busy

  for o in orders
    .sort_by { |o| -o.dishes.len }
    .take(2):
    puts "table #{o.table}: #{o.summary}"

  # longest first
  dishes = orders
    .flat_map { |o| o.dishes }
    .sort_by { |d| -d.len }
  puts dishes.first

  puts orders.map { |o| o.dishes.len }
    .sum
