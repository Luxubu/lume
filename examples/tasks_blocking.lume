# A task that awaits nothing is blocking work, and runs on a pool of its
# own, as Rust's spawn_blocking does: thirty tasks that each sleep 100 ms
# finish together, however many cores there are. `?` and `shared var` work
# in such a task as in any other.

def slow_square(n: Int) -> Int:
  Time.sleep(100)
  n * n

def parse_twice(s: Str) -> Int or Error:
  s.to_int? * 2

async def main:
  start = Time.now_ms
  tasks = (1..30).map { |i| spawn: slow_square(i) }.to_list
  squares = await tasks
  took = Time.now_ms - start
  puts squares.sum
  puts took < 1000

  results = await ["21", "x"].map { |s| spawn: parse_twice(s) }.to_list
  puts results

  shared var done = 0
  var counters: [Task[Int]] = []
  for i in 1..10:
    t = spawn:
      done += 1
      i
    counters.push(t)
  total = await counters
  puts total.sum
  puts done
