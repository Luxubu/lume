# Tests for generic code: one `test` block can exercise a definition at
# several types, which is the whole point of writing it generically.

pub def first[T](xs: [T]) -> T?:
  xs[0]

pub def swap[A, B](p: (A, B)) -> (B, A):
  (p.1, p.0)

pub def unique[T: Hashable](xs: [T]) -> [T]:
  var seen: {T} = {}
  var out: [T] = []
  for x in xs:
    if seen.add(x):
      out.push(x)
  out

pub struct Queue[T]:
  items: [T]

  def put(var self, x: T):
    items.push(x)

  def take(var self) -> T?:
    if items.empty?:
      return None
    first = items[0]
    items = items[1...items.len]
    first

  def len -> Int:
    items.len

def main:
  puts first([1])

test "first works for every element type":
  assert first([3, 1, 2]) == Some(3)
  assert first(["a"]) == Some("a")
  assert first([2.5, 1.0]) == Some(2.5)
  empty: [Int] = []
  assert first(empty) == None

test "a tuple's parts keep their own types":
  assert swap((1, "one")) == ("one", 1)
  assert swap(("x", true)) == (true, "x")

test "unique keeps the first of each":
  assert unique([3, 1, 3, 2, 1]) == [3, 1, 2]
  assert unique(["b", "a", "b"]) == ["b", "a"]

test "a queue is first in, first out":
  var q: Queue[Str] = Queue(items: [])
  q.put("one")
  q.put("two")
  assert q.len == 2
  assert q.take == Some("one")
  assert q.take == Some("two")
  assert q.take == None

test "the same queue, holding something else":
  var q = Queue(items: [1, 2])
  assert q.take == Some(1)
  assert q.len == 1
