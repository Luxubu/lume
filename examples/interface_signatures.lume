# An interface's methods may take and give interface values, and sequences:
# a parameter `o: Shape` takes any value that fits, `-> Shape` gives one
# back, and `-> Iterator[T]` gives a sequence, which a default may make with
# `yield`. In the Rust, the trait takes `&dyn Shape` and gives
# `Box<dyn Shape>` and a boxed iterator, so it stays usable through a pointer.

interface Shape:
  def area -> Float
  def scaled(k: Float) -> Shape
  def bigger?(o: Shape) -> Bool = area > o.area

struct Sq:
  s: Float
  def area -> Float = s * s
  def scaled(k: Float) -> Shape = Sq(s: s * k)

struct Circle:
  r: Float
  def area -> Float = 3.0 * r * r
  def scaled(k: Float) -> Shape = Circle(r: r * k)

# a sequence the type gives, and two defaults made from it
interface Source[T]:
  def each_item -> Iterator[T]
  def firsts(n: Int) -> Iterator[T] = each_item.take(n)
  def numbered -> Iterator[(Int, T)]:
    var i = 1
    for x in each_item:
      yield (i, x)
      i += 1

# a generator gives the sequence
struct Letters:
  text: Str
  def each_item -> Iterator[Str]:
    for c in text.chars:
      yield c.upcase

# so does a chain, handed back from a plain method
struct Squares:
  upto: Int
  def each_item -> Iterator[Int] = (1..upto).map { |n| n * n }

def total[S: Source[Int]](s: S) -> Int = s.each_item.sum

# a plain function may give a sequence too
def from_list(xs: [Int]) -> Iterator[Int] = xs.filter { |x| x > 1 }

def main:
  puts Sq(s: 2.0).bigger?(Circle(r: 1.0))
  shapes: [Shape] = [Sq(s: 1.0), Circle(r: 1.0)]
  puts shapes.at(0).bigger?(shapes.at(1))
  for s in shapes:
    puts s.scaled(2.0).area

  l = Letters(text: "abc")
  puts l.firsts(2).to_list
  for i, c in l.numbered:
    puts "#{i}. #{c}"
  q = Squares(upto: 4)
  puts q.numbered.to_list
  puts total(q)
  sources: [Source[Int]] = [q, Squares(upto: 2)]
  for s in sources:
    puts s.firsts(3).to_list

  puts from_list([1, 2, 3]).to_list
