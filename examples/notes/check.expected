== demo
GET /health -> 200 ok
POST /notes (JSON) -> 201 {"id":1,"title":"tea","body":"green, not too hot","tags":["drink","morning"]}
POST /notes (a form) -> 201 {"id":2,"title":"pie","body":"","tags":["food","sweet"]}
POST /notes (no title) -> 400 {"error":"`title` is missing"}
GET /notes -> 200 [{"id":1,"title":"tea","body":"green, not too hot","tags":["drink","morning"]},{"id":2,"title":"pie","body":"","tags":["food","sweet"]}]
GET /notes?tag=drink -> 200 [{"id":1,"title":"tea","body":"green, not too hot","tags":["drink","morning"]}]
GET /notes/2 -> 200 {"id":2,"title":"pie","body":"","tags":["food","sweet"]}
PUT /notes/1 -> 200 {"id":1,"title":"coffee","body":"","tags":["drink"]}
DELETE /notes/2 -> 204 
DELETE /notes/2 again -> 404 {"error":"no note 2"}
GET /notes/seven -> 404 {"error":"no /notes/seven here"}
PATCH /notes/1 -> 405 {"error":"PATCH is not for /notes/1"}
GET /notes -> 200 [{"id":1,"title":"coffee","body":"","tags":["drink"]}]
