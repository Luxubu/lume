# The Lume examples in a Markdown file: fenced blocks, what kind each is,
# and what it claims about itself.

pub enum Kind:
  Run
  Bad
  Skip
  # tests for the last ```lume program above, run with it by `lume test`
  Tests

pub struct Block:
  kind: Kind
  # the line of the opening fence, counted from 1
  line: Int
  body: [Str]
  # what `lume test` prints for it, when a ```text block beginning `test `
  # follows (a ```sh block between them is passed over); empty otherwise
  test_out: [Str]

# ```lume, ```lume-bad, ```lume-skip or ```lume-tests, and nothing else on the line but
# the indentation of a list item it sits in
def fence_kind(line: Str) -> Kind?:
  match line.trim:
    "```lume" -> Some(Kind.Run)
    "```lume-bad" -> Some(Kind.Bad)
    "```lume-skip" -> Some(Kind.Skip)
    "```lume-tests" -> Some(Kind.Tests)
    _ -> None

# Every fenced Lume block of a file's text, in order.
pub def blocks(text: Str) -> Iterator[Block]:
  lines = text.split("\n")
  var i = 0
  while i < lines.len:
    match fence_kind(lines.at(i)):
      None -> i += 1
      Some(kind) ->
        start = i + 1
        # a block indented under a list item: its lines lose that indent
        fence = lines.at(i)
        indent = fence.len - fence.trim_left.len
        i += 1
        var body: [Str] = []
        while i < lines.len and lines.at(i).trim != "```":
          line = lines.at(i)
          body.push(if line.slice(0, indent).trim.empty?: line.slice(indent, line.len) else: line)
          i += 1
        i += 1
        yield Block(kind: kind, line: start, body: body, test_out: test_output(lines, i))

# The ```text block beginning `test ` that follows line `from`, if one
# does, passing over blank lines and a ```sh block (`lume test x.lume`).
def test_output(lines: [Str], from: Int) -> [Str]:
  var i = from
  while i < lines.len and lines.at(i).trim.empty?:
    i += 1
  if i < lines.len and lines.at(i).trim == "```sh":
    i += 1
    while i < lines.len and lines.at(i).trim != "```":
      i += 1
    i += 1
    while i < lines.len and lines.at(i).trim.empty?:
      i += 1
  if i + 1 >= lines.len or lines.at(i).trim != "```text" or not lines.at(i + 1).starts_with?("test "):
    return []
  i += 1
  var out: [Str] = []
  while i < lines.len and lines.at(i).trim != "```":
    out.push(lines.at(i))
    i += 1
  out

# A block with `test "..."` in it: `lume test` must pass, or print what
# the text after it shows.
pub def has_tests?(body: [Str]) -> Bool = body.any? { |l| l.starts_with?("test \"") }

# The file a test output names — `bill` in `    bill.lume:7: assert ...` —
# so the example is run as that file; `doc` when it names none.
pub def test_file(out: [Str]) -> Str:
  for l in out:
    t = l.trim
    at = t.index_of(".lume:")
    if at.or(-1) > 0 and l.starts_with?("    "):
      return t.slice(0, at.or(0))
  "doc"

# A block is a whole program when it defines `main`; anything else is
# statements, wrapped in one.
pub def program(body: [Str]) -> Str:
  if body.any? { |l| defines_main?(l) }:
    return body.join("\n") + "\n"
  indented = body.map { |l| if l.trim.empty?: "" else: "  " + l }.join("\n")
  "def main:\n" + indented + "\n"

# `def main` or `async def main` at the start of a line, and not a longer
# name such as `def mainly`.
def defines_main?(line: Str) -> Bool:
  rest = if line.starts_with?("async "): line.slice(6, line.len) else: line
  if not rest.starts_with?("def main"):
    return false
  match rest[8]:
    Some(c) -> not (c.alnum? or c == "_")
    None -> true

# What follows `marker` on a line, with one space after it dropped: the text
# of a `#=>` or a `#!` claim.
def after(line: Str, marker: Str) -> Str?:
  at = line.index_of(marker)?
  rest = line.slice(at + marker.len, line.len)
  Some(if rest.starts_with?(" ") or rest.starts_with?("\t"): rest.slice(1, rest.len) else: rest)

# The `#=>` claims, in order: the whole output the example promises.
pub def expected_out(body: [Str]) -> [Str]:
  var out: [Str] = []
  for l in body:
    match after(l, "#=>"):
      Some(t) -> out.push(t.trim_right)
      None -> next
  out

# The `#!` claims of a `lume-bad` block: text its error must contain.
pub def wanted_errors(body: [Str]) -> [Str]:
  var out: [Str] = []
  for l in body:
    match after(l, "#!"):
      Some(t) -> out.push(t.trim)
      None -> next
  out

# A `lume-bad` block without its `#!` lines.
pub def without_claims(body: [Str]) -> [Str] = body.reject { |l| l.contains?("#!") }.to_list
